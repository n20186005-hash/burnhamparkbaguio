---
// Rating at mga review mula sa Google Maps.
// Mahalaga: ang rating/review ay IPINAPAKITA LAMANG sa HTML at HINDI isinasama sa JSON-LD,
// at laging may nakalagay na pahayag ng pinagmulan upang maiwasan ang maling pag-aangkin.
import { GOOGLE_REVIEWS, GOOGLE_REVIEW_THEMES, ENTITY } from '../consts';

const r = GOOGLE_REVIEWS;
const starPct = (r.rating / r.ratingScale) * 100;
const starsAria = `${r.rating} sa ${r.ratingScale} — ${r.reviewCountFormatted} na review mula sa mga gumagamit ng ${r.source}`;
const starSvg =
	'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5 sm:h-6 sm:w-6"><path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z"/></svg>';
const starRow = starSvg.repeat(5);
---

<section
	class="section-pad surface-pine"
	aria-label="Rating at mga review mula sa Google Maps"
	id="mga-review"
>
	<div class="container-page">
		<div class="max-w-3xl mb-8 sm:mb-12">
			<span class="eyebrow">⭐ Rating at Mga Review</span>
			<h2 class="text-balance mb-4">
				Rating ng {ENTITY.attractionPlainName} ({ENTITY.cityName}) mula sa mga gumagamit ng Google Maps
			</h2>
			<p class="text-slate-700 text-lg leading-relaxed">
				Narito ang pinakabagong rating at bilang ng review para sa
				<strong>Burnham Park</strong> — isang <em>{r.category}</em> sa {ENTITY.cityName}, {ENTITY.stateProvince}.
				Ang mga review ay pag-aari ng mga gumagamit ng Google Maps at hindi namin inaangkin.
			</p>
		</div>

		<div class="card overflow-hidden shadow-card border border-pine-100">
			<div class="grid grid-cols-1 lg:grid-cols-12">
				<!-- Panel ng iskor -->
				<div class="lg:col-span-4 bg-pine-950 text-white p-6 sm:p-8 flex flex-col justify-center">
					<p class="text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.2em] text-white/55 mb-2">
						{r.introLabel}
					</p>
					<p class="text-[0.7rem] sm:text-xs font-semibold tracking-[0.08em] text-white/45 mb-4">
						Rating at mga review mula sa mga gumagamit ng Google Maps
					</p>

					<div class="flex items-end gap-3">
						<span class="text-5xl sm:text-6xl font-extrabold leading-none text-white">{r.rating}</span>
						<span class="text-lg sm:text-xl text-white/65 mb-1">/ {r.ratingScale}</span>
					</div>

					<div
						class="relative mt-3 inline-flex"
						role="img"
						aria-label={starsAria}
					>
						<div class="flex gap-1 text-white/25" set:html={starRow}></div>
						<div
							class="absolute inset-0 flex gap-1 overflow-hidden text-amber-300"
							style={`width:${starPct}%`}
							set:html={starRow}
							aria-hidden="true"
						></div>
					</div>

					<p class="mt-3 text-sm text-white/80 leading-relaxed">
						<strong class="text-white">{r.reviewCountFormatted}</strong> review · {r.category} · {r.source}
					</p>

					<!-- Kailangan: maliit na linya ng pinagmulan sa ilalim ng iskor -->
					<p class="mt-4 text-[0.7rem] sm:text-xs leading-relaxed text-white/70">
						{r.creditLine}
					</p>
					<p class="mt-1.5 text-[0.68rem] sm:text-[0.72rem] leading-relaxed text-white/50">
						{r.sourceNoteFil}
					</p>

					<a
						href={r.reviewsUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-pine-900 transition-all duration-200 hover:bg-pine-50 no-underline no-print"
					>
						{r.viewAllLabel}
						<span aria-hidden="true">↗</span>
					</a>
					<span class="mt-2 block text-[0.7rem] text-white/50 no-print">
						{r.viewAllLabelFil}
					</span>
				</div>

				<!-- Mga paulit-ulit na tema sa mga review (buod, hindi direktang sipi) -->
				<div class="lg:col-span-8 p-6 sm:p-8">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-2">
						💬 Mga Tema sa mga Review sa Google Maps
					</p>
					<p class="text-xs sm:text-sm text-slate-500 mb-5 leading-relaxed">
						Buod ng mga paulit-ulit na paksang binabanggit sa mga review — hindi ito direktang sipi
						mula sa partikular na review ng sinuman.
					</p>

					<ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
						{GOOGLE_REVIEW_THEMES.map((t) => (
							<li class="rounded-2xl border border-pine-100 bg-pine-50/60 p-4 flex items-start gap-3">
								<span class="text-2xl shrink-0" aria-hidden="true">{t.icon}</span>
								<div>
									<h3 class="text-sm sm:text-base font-bold text-pine-950 mb-1">{t.title}</h3>
									<p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{t.desc}</p>
								</div>
							</li>
						))}
					</ul>

					<!-- Pahayag ng pinagmulan at copyright ng bloke ng mga review -->
					<div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50/70 p-4 sm:p-5">
						<p class="text-[0.72rem] sm:text-xs leading-relaxed text-amber-900">
							<strong class="font-bold">Pinagmulan ng mga review：</strong>{r.sourceNote}
						</p>
						<p class="mt-1.5 text-[0.7rem] sm:text-xs leading-relaxed text-amber-800/80">
							{r.sourceNoteFil}
						</p>
						<p class="mt-2 text-[0.7rem] sm:text-xs leading-relaxed text-amber-800/80">
							Hindi kami kaanib ng Google；ang Google Maps ay trademark ng Google LLC.
							Hindi isinasama ang mga review sa structured data (JSON-LD) ng pahinang ito.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
