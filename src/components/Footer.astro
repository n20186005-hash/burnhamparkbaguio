---
import { SITE, NAV, DISCLAIMER } from '../consts';
const currentYear = new Date().getFullYear();
---

<footer class="bg-pine-950 text-white/85">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-18 space-y-12 sm:space-y-14">

		<!-- 1. Sitemap / Quick links -->
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 sm:gap-10">
			<div class="col-span-2 sm:col-span-1">
				<a href="/" class="inline-flex items-center gap-2.5 font-bold text-lg text-white no-underline hover:opacity-80 transition-opacity duration-200 mb-3">
					<span aria-hidden="true">🏞️</span> Burnham Park
				</a>
				<p class="text-sm text-white/60 leading-relaxed max-w-xs">
					Isang independiyente at di-komersyal na gabay sa pinakamahalagang pampublikong parke ng Baguio.
				</p>
			</div>

			<div>
				<h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-3">Tungkol sa Parke</h4>
				<ul class="space-y-2.5">
					<li><a href="#tungkol" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Tungkol</a></li>
					<li><a href="#kasaysayan" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Kasaysayan</a></li>
					<li><a href="#alamat" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Pamana</a></li>
					<li><a href="#atraksyon" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">12 Atraksyon</a></li>
					<li><a href="#gawain" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Mga Aktibidad</a></li>
				</ul>
			</div>

			<div>
				<h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-3">Plano</h4>
				<ul class="space-y-2.5">
					<li><a href="#praktikal" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Praktikal</a></li>
					<li><a href="#transportasyon" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Transportasyon</a></li>
					<li><a href="#pagkain" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Pagkain</a></li>
					<li><a href="#matutuluyan" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Matutuluyan</a></li>
				</ul>
			</div>

			<div>
				<h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-3">Higit Pa</h4>
				<ul class="space-y-2.5">
					<li><a href="#kalapit" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Kalapit</a></li>
					<li><a href="#galeriya" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Galeriya</a></li>
					<li><a href="#tip" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">Mga Tip</a></li>
					<li><a href="#faq" class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">FAQ</a></li>
				</ul>
			</div>

			<div>
				<h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-3">Mapa</h4>
				<a
					href={SITE.mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/20 transition-colors duration-200 no-underline"
				>
					🗺️ Buksan sa Google Maps
				</a>
			</div>
		</div>

		<!-- 2. Disclaimer -->
		<div class="max-w-3xl pt-8 border-t border-white/10">
			<p class="text-xs text-white/50 leading-relaxed">
				{DISCLAIMER.text}
			</p>
		</div>

		<!-- 3. Bottom bar -->
		<div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-white/50">
			<span>&copy; {currentYear} {SITE.name}. Hindi kaakibat ng gobyerno. CC BY-NC 4.0.</span>
			<div class="flex flex-wrap gap-4">
				<a href="/#patalastas" class="hover:text-white transition-colors duration-200 no-underline">Patalastas</a>
			</div>
		</div>

	</div>
</footer>
