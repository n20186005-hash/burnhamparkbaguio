---
import type { Cluster } from '../consts';
const { cluster } = Astro.props as { cluster: Cluster };
---

<article
	class="card overflow-hidden flex flex-col h-full transition-transform duration-300 hover:-translate-y-1"
	data-cluster-card
	data-cluster-category={cluster.category}
>
	<div class="px-5 pt-5 sm:px-6 sm:pt-6 pb-4 flex-1 flex flex-col">
		<div class="flex items-start justify-between mb-2 gap-3">
			<h3 class="text-lg sm:text-xl font-bold text-pine-950 leading-snug">{cluster.title}</h3>
			<span class="chip text-[0.65rem] tracking-[0.1em] shrink-0">
				⏱ {cluster.minutes}
			</span>
		</div>
		<p class="text-xs text-pine-700/80 font-semibold uppercase tracking-[0.12em] mb-3">{cluster.tagline}</p>
		<p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">{cluster.description}</p>

		<div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-slate-100">
			<span class="text-[0.65rem] text-slate-400 font-semibold uppercase tracking-[0.1em] mr-1 mt-0.5">Pinakamainam para sa:</span>
			{cluster.best.map((b) => (
				<span class="inline-flex px-2 py-0.5 rounded-full text-[0.65rem] font-semibold bg-pine-50 text-pine-700 border border-pine-100">
					{b}
				</span>
			))}
		</div>
	</div>
</article>
