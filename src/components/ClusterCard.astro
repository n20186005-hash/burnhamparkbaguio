---
import type { Cluster } from '../consts';

export interface Props {
	cluster: Cluster;
}

const { cluster } = Astro.props;
---

<article
	class="group rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 ease-out flex h-full flex-col overflow-hidden"
	data-cluster-card
	data-cluster-category={cluster.category ?? 'nature'}
>
	<div class="relative w-full overflow-hidden bg-gradient-to-br from-pine-800 via-pine-700 to-lagoon-700">
		<div class="absolute inset-0 opacity-20" aria-hidden="true" style="background:
			radial-gradient(600px 200px at 20% -10%, rgba(255,255,255,0.35), transparent 60%),
			radial-gradient(500px 180px at 90% 110%, rgba(217,169,176,0.55), transparent 60%);"></div>
		<div class="relative p-5 sm:p-6 text-white">
			<p class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-rose-sand-100/90 mb-1.5">
				{cluster.tagline} · {cluster.minutes}
			</p>
			<h3 class="text-lg sm:text-xl font-bold leading-tight">
				{cluster.title}
			</h3>
		</div>
	</div>

	<div class="flex flex-1 flex-col p-4">
		<p class="text-sm text-slate-700 leading-relaxed mb-4">
			{cluster.description}
		</p>

		<div class="mt-auto space-y-3">
			<p class="text-[11px] font-bold uppercase tracking-[0.18em] text-pine-700">
				Pinakamainam para sa
			</p>
			<div class="chip-group">
				{
					cluster.best.map((tag) => (
						<span class="chip">{tag}</span>
					))
				}
			</div>
		</div>
	</div>
</article>
