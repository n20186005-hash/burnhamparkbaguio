---
import type { Cluster } from '../consts';

export interface Props {
	cluster: Cluster;
}

const { cluster } = Astro.props;
---

<article class="card card-hover flex h-full flex-col">
	<div class="relative aspect-[16/10] overflow-hidden">
		<img
			src={cluster.image}
			alt={cluster.imageAlt}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover transition-transform duration-500 ease-out hover:scale-105"
			style="border-radius:0"
		/>
		<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-pine-950/85 via-pine-950/30 to-transparent p-4 pt-10 text-white">
			<p class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-rose-sand-200/90 mb-1">
				{cluster.tagline} · {cluster.minutes}
			</p>
			<h3 class="text-lg sm:text-xl font-bold leading-tight">
				{cluster.title}
			</h3>
		</div>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<p class="text-sm text-cold-700 leading-relaxed mb-4">
			{cluster.description}
		</p>

		<div class="mt-auto space-y-3">
			<p class="text-[11px] font-bold uppercase tracking-[0.18em] text-pine-700">
				Pinakamainam para sa
			</p>
			<div class="chip-group">
				{
					cluster.best.map((tag) => (
						<span class="chip">{tag}</span>
					))
				}
			</div>
		</div>
	</div>
</article>
