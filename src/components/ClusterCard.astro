---
import type { Cluster } from '../consts';

export interface Props {
	cluster: Cluster;
}

const { cluster } = Astro.props;
---

<article
	class="group rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 ease-out flex h-full flex-col overflow-hidden"
	data-cluster-card
	data-cluster-category={cluster.category ?? 'nature'}
>
	<div class="relative aspect-video w-full overflow-hidden">
		<picture>
			<source
				type="image/webp"
				srcset={`${cluster.image}&w=800&fm=webp 800w, ${cluster.image}&w=1200&fm=webp 1200w`}
				sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
			/>
			<img
				src={cluster.image}
				alt={cluster.imageAlt}
				loading="lazy"
				decoding="async"
				class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
				style="border-radius:0"
			/>
		</picture>
		<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-pine-950/85 via-pine-950/30 to-transparent p-4 pt-10 text-white">
			<p class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-rose-sand-200/90 mb-1">
				{cluster.tagline} · {cluster.minutes}
			</p>
			<h3 class="text-lg sm:text-xl font-bold leading-tight">
				{cluster.title}
			</h3>
		</div>
	</div>

	<div class="flex flex-1 flex-col p-4">
		<p class="text-sm text-slate-700 leading-relaxed mb-4">
			{cluster.description}
		</p>

		<div class="mt-auto space-y-3">
			<p class="text-[11px] font-bold uppercase tracking-[0.18em] text-pine-700">
				Pinakamainam para sa
			</p>
			<div class="chip-group">
				{
					cluster.best.map((tag) => (
						<span class="chip">{tag}</span>
					))
				}
			</div>
		</div>
	</div>
</article>
