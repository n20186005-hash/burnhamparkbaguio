---
import { KEY_INFO } from '../consts';
---

<section class="relative z-10 -mt-12 sm:-mt-16 md:-mt-20 mb-8 sm:mb-12" aria-label="Mabilis na impormasyon">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
			{KEY_INFO.map((k) => (
				<div class="card bg-white/95 backdrop-blur-sm shadow-card p-4 sm:p-5 flex flex-col items-start gap-2 hover:-translate-y-1 transition-transform duration-300">
					<div class="flex items-center gap-2.5">
						<span class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-pine-100 text-lg shrink-0" aria-hidden="true">
							{k.icon === 'ticket' ? '🎫' : k.icon === 'clock' ? '🕐' : k.icon === 'stopwatch' ? '⌛' : '💚'}
						</span>
						<span class="text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.15em] text-pine-700">{k.label}</span>
					</div>
					<div>
						<span class="text-lg sm:text-xl font-extrabold text-pine-950 leading-tight">{k.value}</span>
						<p class="text-[0.68rem] sm:text-xs text-slate-500 mt-0.5">{k.sub}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
