---
// Agham at responsibilidad ng bisita — nilalayong maging non-profit na sangguniang pang-edukasyon.
import { SCIENCE_NOTES, ENTITY } from '../consts';

const LEAVE_NO_TRACE = [
	'Magplano nang maaga: alamin ang ruta, panahon, at mga tuntunin ng parke bago dumating.',
	'Manatili sa mga itinalagang daanan upang hindi masira ang ugat ng puno at takip ng lupa.',
	'Iuuwi ang sariling basura — kabilang ang balot, buto, at basong plastic.',
	'Iwan ang mga likas na bagay: huwag pumitas ng bulaklak, huwag kumuha ng bato o dahon.',
	'Huwag magpakain ng mga ibon at hayop — nakakasira ito ng natural na paghahanap nila ng pagkain.',
	'Igalang ang ibang bisita, mga nagtatrabaho sa parke, at ang kultural na kahalagahan ng lugar.',
];
---

<section class="section-pad surface-pine" aria-label="Agham at responsibilidad ng bisita" id="agham">
	<div class="container-page">
		<div class="max-w-3xl mb-9 sm:mb-12">
			<span class="eyebrow">🔬 Agham at Responsibilidad</span>
			<h2 class="text-balance mb-4">
				Paano gumagana ang {ENTITY.attractionPlainName} bilang ecosystem — at ano ang bahagi mo bilang bisita
			</h2>
			<p class="text-slate-700 text-lg leading-relaxed">
				Bilang non-profit na gabay pang-impormasyon, layunin naming ipaliwanag hindi lamang kung ano ang
				makikita, kundi kung bakit ito mahalaga. Ang pag-unawa sa klima, lupa, tubig, at kasaysayan ng
				parke ay nagpapabago sa karanasan ng pagbisita — at nakakatulong na mapanatili ito para sa susunod
				na henerasyon.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-10 sm:mb-14">
			{SCIENCE_NOTES.map((n) => (
				<article class="card p-5 flex flex-col h-full">
					<span class="text-2xl mb-3" aria-hidden="true">{n.icon}</span>
					<h3 class="text-base font-bold text-pine-950 mb-2 leading-snug">{n.title}</h3>
					<p class="text-sm text-slate-600 leading-relaxed flex-1">{n.desc}</p>
				</article>
			))}
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6">
			<!-- Leave No Trace -->
			<div class="lg:col-span-7 card p-6 sm:p-8 border border-pine-100">
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-3">
					🌱 Leave No Trace: Pitong Prinsipyo
				</p>
				<ol class="space-y-2.5">
					{LEAVE_NO_TRACE.map((rule, i) => (
						<li class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
							<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-pine-950 text-[0.7rem] font-bold text-white">
								{i + 1}
							</span>
							<span>{rule}</span>
						</li>
					))}
				</ol>
			</div>

			<!-- Paalala sa paggamit ng impormasyon -->
			<div class="lg:col-span-5 card p-6 sm:p-8 bg-white/70">
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 mb-3">
					📌 Tungkol sa gabay na ito
				</p>
				<ul class="space-y-2.5 text-sm text-slate-700 leading-relaxed">
					<li class="flex items-start gap-2">
						<span aria-hidden="true">✅</span>
						<span>Non-profit at independiyente: walang bayad na listing, walang komisyon sa booking.</span>
					</li>
					<li class="flex items-start gap-2">
						<span aria-hidden="true">✅</span>
						<span>Tanging uri lamang ng serbisyo ang binabanggit — walang itinatampok na partikular na negosyo.</span>
					</li>
					<li class="flex items-start gap-2">
						<span aria-hidden="true">⚠️</span>
						<span>
							Ang mga numero ay gabay lamang. Bago magbiyahe, suriin ang opisyal na abiso ng
							pamahalaang lungsod at ng pambansang tanggapan ng meteorolohiya.
						</span>
					</li>
					<li class="flex items-start gap-2">
						<span aria-hidden="true">♻️</span>
						<span>
							Nakakatulong ka sa pangangalaga ng parke sa pamamagitan ng paggamit ng pampublikong
							transportasyon at pag-uwi ng sariling basura.
						</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
