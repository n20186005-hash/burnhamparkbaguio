---
import { SITE } from '../consts';

const gaId = import.meta.env.PUBLIC_GA4_ID ?? SITE.ga4Id;
---

<Fragment is:inline>
	<!-- Google Analytics 4 (GA4) -->
	<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
	<script is:inline define:vars={{ gaId }}>
		window.dataLayer = window.dataLayer || [];
		function gtag() {
			dataLayer.push(arguments);
		}
		gtag('js', new Date());
		gtag('config', gaId, {
			anonymize_ip: true,
			page_path: window.location.pathname,
		});
		// Track outbound links to external pages
		document.addEventListener('click', function (e) {
			var target = e.target.closest('a');
			if (target && target.host && target.host !== window.location.host) {
				gtag('event', 'click_external_link', {
					event_category: 'Outbound',
					event_label: target.href,
					transport_type: 'beacon',
				});
			}
		});
	</script>
</Fragment>
