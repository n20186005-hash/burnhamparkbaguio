---
import { NAV, SITE } from '../consts';
const mapsUrl = SITE.mapsUrl;
---

<header class="site-header bg-white/85 backdrop-blur-md border-b border-pine-100 sticky top-0 z-40">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex h-16 items-center justify-between">
			<!-- Logo -->
			<a href="/" class="inline-flex items-center gap-2.5 font-bold text-lg text-pine-950 no-underline hover:opacity-80 transition-opacity duration-200 shrink-0">
				<span aria-hidden="true" class="text-xl">🏞️</span>
				<span class="hidden sm:inline">Burnham Park</span>
				<span class="sm:hidden">Burnham</span>
			</a>

			<!-- Desktop nav -->
			<nav class="hidden lg:flex items-center gap-1 overflow-x-auto" aria-label="Pangunahing nabigasyon">
				{NAV.map((item) => (
					<a
						href={item.href}
						class="nav-link inline-flex items-center px-2.5 py-1.5 rounded-lg text-sm font-semibold text-slate-700 hover:text-pine-900 hover:bg-pine-50 transition-colors duration-200 whitespace-nowrap"
					>
						{item.label}
					</a>
				))}
			</nav>

			<!-- Map CTA (desktop) -->
			<div class="hidden lg:flex items-center gap-3">
				<a href={mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 rounded-full bg-pine-900 px-4 py-2 text-sm font-semibold text-white shadow-soft hover:bg-pine-800 active:scale-[0.98] transition-all duration-200 no-underline"
				>
					🗺️ <span>Buksan sa Maps</span>
				</a>
			</div>
		</div>
	</div>
</header>
