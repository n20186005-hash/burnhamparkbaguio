---
import { FAQS } from '../consts';
---

<div class="card p-4 sm:p-6 md:p-8">
	<ol class="divide-y divide-cold-200">
		{
			FAQS.map((faq, i) => (
				<li class="accordion-item" id={`faq-${i + 1}`}>
					<details class="group">
						<summary class="accordion-trigger group-open:text-pine-700">
							<span>{faq.q}</span>
							<span class="shrink-0 ml-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-cold-200 bg-cold-50 text-pine-800 transition-transform duration-300 ease-out group-open:rotate-45 group-open:bg-pine-50 group-open:border-pine-200" aria-hidden="true">
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
									<path d="M12 5v14M5 12h14" />
								</svg>
							</span>
						</summary>
						<div class="pb-6 pr-2">
							<div class="prose-fil !max-w-none mt-1 !mb-0">
								<p class="!mb-0">{faq.a}</p>
							</div>
						</div>
					</details>
				</li>
			))
		}
	</ol>
</div>
