---
import { SITE } from '../consts';

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	structuredData?: Record<string, unknown>;
	hreflang?: { locale: string; url: string }[];
}

const {
	title,
	description = SITE.description,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	structuredData,
	hreflang,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.siteUrl).toString();

const resolveAbsolute = (src: string) =>
	src.startsWith('http') ? src : new URL(src, Astro.site ?? SITE.siteUrl).toString();

const ogImageURL = resolveAbsolute(
	ogImage ?? (SITE as any).ogImageDefault ?? '/og-default.svg'
);
const pageOgImageAlt = ogImageAlt ?? 'Burnham Park Baguio official visitor guide scenic overview';

const defaultHreflang =
	hreflang ??
	([
		{ locale: 'fil', url: canonicalURL },
		{ locale: 'en', url: canonicalURL },
		{ locale: 'x-default', url: canonicalURL },
	] as const);

const defaultStructuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'TouristAttraction',
			'@id': `${SITE.siteUrl}/#park`,
			name: 'Burnham Park (Burnham Park Reservation)',
			alternateName: ['Burnham Park Baguio', 'Burnham Park Reservation'],
			additionalType: 'https://schema.org/Park',
			description: SITE.description,
			url: SITE.siteUrl,
			image: [resolveAbsolute((SITE as any).ogImageDefault ?? ogImageURL)],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Jose Abad Santos Drive',
				addressLocality: 'Baguio',
				addressRegion: 'Benguet',
				postalCode: '2600',
				addressCountry: {
					'@type': 'Country',
					name: 'PH',
				},
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: SITE.coordinates.lat,
				longitude: SITE.coordinates.lng,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: [
						'Monday',
						'Tuesday',
						'Wednesday',
						'Thursday',
						'Friday',
						'Saturday',
						'Sunday',
					],
					opens: '00:00',
					closes: '23:59',
				},
			],
			publicAccess: 'https://schema.org/PublicAccess',
			isAccessibleForFree: true,
			wheelchairAccessible: true,
			priceRange: 'Free',
			sameAs: ['https://en.wikipedia.org/wiki/Burnham_Park_(Baguio)'],
		},
		{
			'@type': 'WebSite',
			name: SITE.name,
			url: SITE.siteUrl,
			inLanguage: SITE.language,
			publisher: {
				'@type': 'Organization',
				name: SITE.author,
				url: SITE.siteUrl,
			},
			potentialAction: {
				'@type': 'SearchAction',
				target: `${SITE.siteUrl}/?s={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		},
	],
};

const mergedStructuredData = structuredData ?? defaultStructuredData;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="language" content={SITE.language} />
<meta name="geo.region" content="PH-15" />
<meta name="geo.placename" content="Baguio" />
<meta name="geo.position" content={`${SITE.coordinates.lat};${SITE.coordinates.lng}`} />
<meta name="ICBM" content={`${SITE.coordinates.lat}, ${SITE.coordinates.lng}`} />

<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

{
	defaultHreflang.map((h) => (
		<link rel="alternate" hreflang={h.locale} href={h.url} />
	))
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:alt" content={pageOgImageAlt} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1600" />
<meta property="og:image:height" content="900" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:locale:alternate" content="en_PH" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={pageOgImageAlt} />
<meta name="twitter:domain" content="burnhamparkbaguio.com" />

<!-- Robots: index, follow, large image preview -->
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="googlebot" content="index,follow" />
<meta name="bingbot" content="index,follow" />

<!-- Security & Privacy -->
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(self 'https://www.google.com'), interest-cohort=()" />

<!-- Preconnect for image CDN & Google -->
<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
<link rel="dns-prefetch" href="https://images.unsplash.com" />
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://www.google-analytics.com" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(mergedStructuredData)}></script>
