---
// Mga serbisyo at pasilidad para sa bisita.
// Tanging URI lamang ang binabanggit (hal. "convenience store", "gasolinahan") — walang
// partikular na pangalan ng negosyo, upang manatiling obhetibo at di-komersyal.
import { VISITOR_SERVICES, ENTITY } from '../consts';

const groups = [...new Set(VISITOR_SERVICES.map((s) => s.group))];

const locationStyle = (loc: string) => {
	if (loc.startsWith('Sa loob')) return 'bg-pine-100 text-pine-800';
	if (loc.startsWith('Malapit') || loc.startsWith('Labas')) return 'bg-sky-100 text-sky-800';
	if (loc.startsWith('Walang')) return 'bg-rose-100 text-rose-800';
	return 'bg-amber-100 text-amber-800';
};
---

<section class="section-pad" aria-label="Mga serbisyo at pasilidad para sa bisita" id="serbisyo">
	<div class="container-page">
		<div class="max-w-3xl mb-9 sm:mb-12">
			<span class="eyebrow">🧰 Mga Serbisyo at Pasilidad</span>
			<h2 class="text-balance mb-4">
				Ano ang available sa loob at paligid ng {ENTITY.attractionPlainName}? (buod ayon sa uri)
			</h2>
			<p class="text-slate-700 text-lg leading-relaxed">
				Sinusuri ng seksyong ito ang mga kategorya ng pasilidad na karaniwang kailangan ng bisita —
				palikuran, paradahan, kainan, pamimili, gasolina, charging, at pang-emerhensiya.
				<strong>Tanging uri lamang ang binabanggit</strong> at walang itinatampok na partikular na negosyo:
				pumili ayon sa sariling pangangailangan at lokasyon.
			</p>
		</div>

		{groups.map((group) => (
			<div class="mb-8 last:mb-0">
				<h3 class="text-lg sm:text-xl font-bold text-pine-950 mb-4 flex items-center gap-2">
					<span aria-hidden="true" class="h-5 w-1.5 rounded-full bg-pine-700 inline-block"></span>
					{group}
				</h3>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
					{VISITOR_SERVICES.filter((s) => s.group === group).map((s) => (
						<article class="card p-5 flex flex-col h-full">
							<div class="flex items-start justify-between gap-2 mb-2.5">
								<span class="text-2xl" aria-hidden="true">{s.icon}</span>
								<span class={`rounded-full px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide ${locationStyle(s.location)}`}>
									{s.location}
								</span>
							</div>
							<h4 class="text-base font-bold text-pine-950 mb-1.5 leading-snug">{s.title}</h4>
							<p class="text-sm text-slate-600 leading-relaxed flex-1">{s.desc}</p>
						</article>
					))}
				</div>
			</div>
		))}

		<div class="mt-8 rounded-[1.5rem] border border-slate-200 bg-white p-5 sm:p-6">
			<p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 mb-2">
				Pangkalahatang paalala
			</p>
			<p class="text-sm text-slate-700 leading-relaxed">
				Ang availability ng mga pasilidad ay nagbabago ayon sa oras, panahon, at anunsyo ng
				pamahalaang lungsod. Tuwing Panagbenga (Pebrero) at Kapaskuhan, mas mabilis mapuno ang
				paradahan at palikuran — maglaan ng dagdag na oras. Para sa opisyal na abiso, sumangguni sa
				pahina ng Lungsod ng Baguio at sa tanggapan ng parke (CEPMO).
			</p>
		</div>
	</div>
</section>
