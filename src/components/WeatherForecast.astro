---
// Modyul ng panahon para sa Burnham Park.
// Ang datos ay hinihingi sa SERVER bago mai-render ang pahina (hindi sa browser ng bisita),
// kaya kahit hindi pa na-load ang script, may agad na makikitang payo para sa biyahe.
import { ENTITY, CLIMATE_MONTHS } from '../consts';
import {
	buildAdvice,
	buildDayHint,
	describeCode,
	feelPhrase,
	airPhrase,
	uvPhrase,
	windPhrase,
	type WeatherFacts,
} from '../lib/weather-advisory';

const LAT = ENTITY.latitude;
const LNG = ENTITY.longitude;
const PHT = 'Asia/Manila';

const QUERY_STRING =
	`latitude=${LAT}&longitude=${LNG}` +
	`&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,uv_index` +
	`&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,uv_index_max,wind_speed_10m_max` +
	`&forecast_days=7&timezone=${encodeURIComponent(PHT)}&wind_speed_unit=kmh`;

const ENDPOINT = `https://api.open-meteo.com/v1/forecast?${QUERY_STRING}`;

type Snapshot = {
	current: WeatherFacts;
	updated: string;
	daily: { date: string; code: number; max: number; min: number; pop: number; sum: number; uv: number; wind: number }[];
};

async function loadSnapshot(): Promise<Snapshot | null> {
	try {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), 8000);
		const res = await fetch(ENDPOINT, { signal: controller.signal });
		clearTimeout(timer);
		if (!res.ok) return null;
		const json = await res.json();
		const c = json?.current;
		const d = json?.daily;
		if (!c || !d || !Array.isArray(d.time)) return null;
		const daily = d.time.map((date: string, i: number) => ({
			date,
			code: Number(d.weather_code?.[i] ?? 3),
			max: Math.round(d.temperature_2m_max?.[i] ?? 0),
			min: Math.round(d.temperature_2m_min?.[i] ?? 0),
			pop: Math.round(d.precipitation_probability_max?.[i] ?? 0),
			sum: Number(d.precipitation_sum?.[i] ?? 0),
			uv: Number(d.uv_index_max?.[i] ?? 0),
			wind: Math.round(d.wind_speed_10m_max?.[i] ?? 0),
		}));
		const today = daily[0] ?? { code: 3, max: 0, min: 0, pop: 0, sum: 0, uv: 0, wind: 0 };
		return {
			current: {
				code: Number(c.weather_code ?? today.code),
				temp: Math.round(c.temperature_2m ?? today.max),
				apparent: Math.round(c.apparent_temperature ?? c.temperature_2m ?? today.max),
				humidity: Math.round(c.relative_humidity_2m ?? 75),
				wind: Math.round(c.wind_speed_10m ?? 0),
				gust: Math.round(c.wind_gusts_10m ?? c.wind_speed_10m ?? 0),
				precip: Number(c.precipitation ?? 0),
				pop: today.pop,
				sum: today.sum,
				uv: Number(c.uv_index ?? today.uv),
				max: today.max,
				min: today.min,
			},
			updated: typeof c.time === 'string' ? c.time : '',
			daily,
		};
	} catch {
		return null;
	}
}

const live = await loadSnapshot();

// Fallback: karaniwang halaga para sa buwan kung hindi maabot ang pinagmumulan ng datos.
const now = new Date();
const phMonth =
	Number(new Intl.DateTimeFormat('en-PH', { timeZone: PHT, month: 'numeric' }).format(now)) - 1;
const monthSeed = CLIMATE_MONTHS[Math.min(Math.max(phMonth, 0), 11)];

const monthCode = monthSeed.rainDays > 12 ? 61 : monthSeed.rainDays > 5 ? 3 : 1;
const fallbackDaily = CLIMATE_MONTHS.slice(phMonth, phMonth + 7)
	.concat(CLIMATE_MONTHS.slice(0, Math.max(0, phMonth + 7 - 12)))
	.map((m, i) => {
		const d = new Date(now.getTime() + i * 86400000);
		return {
			date: d.toISOString().slice(0, 10),
			code: m.rainDays > 12 ? 61 : m.rainDays > 5 ? 3 : 1,
			max: m.high,
			min: m.low,
			pop: Math.min(95, Math.round((m.rainDays / 30) * 100)),
			sum: Math.round((m.rain / 30) * 10) / 10,
			uv: 6,
			wind: 10,
		};
	});

const snapshot: Snapshot = live ?? {
	current: {
		code: monthCode,
		temp: monthSeed.high,
		apparent: monthSeed.low,
		humidity: 78,
		wind: 8,
		gust: 14,
		precip: 0,
		pop: fallbackDaily[0]?.pop ?? 0,
		sum: fallbackDaily[0]?.sum ?? 0,
		uv: 6,
		max: monthSeed.high,
		min: monthSeed.low,
	},
	updated: '',
	daily: fallbackDaily,
};

const isLive = Boolean(live);
const facts = snapshot.current;
const advice = buildAdvice(facts);
const current = describeCode(facts.code);
const currentWind = Math.max(facts.wind, facts.gust);

const dayLabel = (iso: string, i: number) => {
	if (i === 0) return 'Ngayon';
	const d = new Date(`${iso}T12:00:00+08:00`);
	return new Intl.DateTimeFormat('fil-PH', { weekday: 'short', timeZone: PHT }).format(d);
};

const dateLabel = (iso: string) => {
	const d = new Date(`${iso}T12:00:00+08:00`);
	return new Intl.DateTimeFormat('fil-PH', { month: 'short', day: 'numeric' }).format(d);
};

const updatedLabel = snapshot.updated
	? new Intl.DateTimeFormat('fil-PH', {
			month: 'long',
			day: 'numeric',
			hour: '2-digit',
			minute: '2-digit',
			timeZone: PHT,
		}).format(new Date(snapshot.updated))
	: '';

const adviceBlocks = [
	{ key: 'outfit', icon: '👕', title: 'Isusuot', items: advice.outfit, tone: 'text-pine-950' },
	{ key: 'plan', icon: '🗺️', title: 'Paglilibot', items: advice.plan, tone: 'text-pine-950' },
	{ key: 'gear', icon: '🎒', title: 'Dadalhin', items: advice.gear, tone: 'text-pine-950' },
];
---

<section
	class="section-pad surface-pine"
	aria-label="Kasalukuyang panahon at pitong araw na pagtataya"
	id="panahon"
	data-weather-root
	data-weather-query={QUERY_STRING}
>
	<div class="container-page">
		<div class="max-w-3xl mb-8 sm:mb-12">
			<span class="eyebrow">🌦️ Panahon sa {ENTITY.attractionShortName}</span>
			<h2 class="text-balance mb-4">
				Kasalukuyang lagay ng panahon sa {ENTITY.attractionPlainName} at pitong araw na pagtataya sa {ENTITY.cityName}
			</h2>
			<p class="text-slate-700 text-lg leading-relaxed">
				Nasa {ENTITY.latitude}°N {ENTITY.longitude}°E at humigit-kumulang 1,500 metro sa ibabaw ng dagat ang parke —
				kaya mabilis magbago ang ulap at malamig ang madaling araw. Sa halip na hilaw na numero lamang,
				ibinibigay namin ang direktang payo: kung kailangan ng payong, ano ang isusuot, at paano iikot ang parke.
			</p>
		</div>

		<!-- 🚨 Babala — lumilitaw lamang kapag may panganib -->
		<div
			data-weather-alerts
			hidden={advice.alerts.length === 0}
			class="mb-6 sm:mb-8 rounded-3xl border-2 border-red-300 bg-red-50 p-5 sm:p-6 shadow-soft"
		>
			<p class="flex items-center gap-2 text-xs sm:text-sm font-bold uppercase tracking-[0.16em] text-red-700 mb-3">
				<span aria-hidden="true">⚠️</span> Babala para sa kaligtasan
			</p>
			<ul class="space-y-2 text-sm sm:text-[15px] text-red-900 leading-relaxed list-disc list-outside ms-5" data-weather-alerts-list>
				{advice.alerts.map((a) => <li>{a}</li>)}
			</ul>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6">
			<!-- 1. Pangunahing kard ng panahon + payo -->
			<div class="lg:col-span-5 card p-6 sm:p-8 border border-pine-100 shadow-card">
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-4">
					{isLive ? 'Kasalukuyan' : 'Karaniwan para sa buwang ito'}
				</p>

				{!isLive && (
					<p class="mb-4 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2 text-xs sm:text-sm text-amber-800 leading-relaxed">
						Hindi ma-load ang live na datos ng panahon — ipinapakita ang karaniwang halaga para sa buwang ito.
						Awtomatikong ina-refresh ang datos sa pagbukas ng pahina.
					</p>
				)}

				<div class="flex items-start gap-4">
					<span class="text-5xl sm:text-6xl leading-none" aria-hidden="true" data-weather-icon>{current.icon}</span>
					<div>
						<p class="text-4xl sm:text-5xl font-bold text-pine-950 leading-none">
							<span data-weather-temp>{facts.temp}</span><span class="text-2xl text-pine-700">°C</span>
						</p>
						<p class="mt-1.5 text-sm sm:text-base font-semibold text-slate-700" data-weather-desc>{current.label}</p>
					</div>
				</div>

				<!-- Datos sa wikang pang-araw-araw -->
				<dl class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 text-sm">
					<div class="rounded-xl bg-pine-50 px-4 py-3">
						<dt class="text-xs text-slate-500">Pakiramdam sa labas</dt>
						<dd class="font-bold text-pine-950">
							<span data-weather-apparent>{facts.apparent}</span>°C
							<span class="block text-[0.7rem] font-medium text-slate-500" data-weather-feel>{feelPhrase(facts.apparent)}</span>
						</dd>
					</div>
					<div class="rounded-xl bg-pine-50 px-4 py-3">
						<dt class="text-xs text-slate-500">Tsansa ng ulan</dt>
						<dd class="font-bold text-pine-950"><span data-weather-pop>{facts.pop}</span>%
							<span class="block text-[0.7rem] font-medium text-slate-500">{facts.sum} mm inaasahan</span>
						</dd>
					</div>
					<div class="rounded-xl bg-pine-50 px-4 py-3">
						<dt class="text-xs text-slate-500">Hangin</dt>
						<dd class="font-bold text-pine-950">
							<span data-weather-wind>{windPhrase(currentWind)}</span>
							<span class="block text-[0.7rem] font-medium text-slate-500">{currentWind} km/h</span>
						</dd>
					</div>
					<div class="rounded-xl bg-pine-50 px-4 py-3">
						<dt class="text-xs text-slate-500">Init ng araw</dt>
						<dd class="font-bold text-pine-950">
							<span data-weather-uv>{uvPhrase(facts.uv)}</span>
							<span class="block text-[0.7rem] font-medium text-slate-500">{airPhrase(facts.humidity)}</span>
						</dd>
					</div>
				</dl>

				<!-- Buod at tanong na "kailangan ba ng payong?" -->
				<p class="mt-6 rounded-2xl bg-pine-900 text-white px-4 py-3 text-sm sm:text-[15px] font-semibold leading-relaxed">
					<span data-weather-headline>{advice.headline}</span>
				</p>
				<p class="mt-3 flex items-start gap-2 text-sm text-slate-700 leading-relaxed">
					<span aria-hidden="true">☔</span>
					<span data-weather-umbrella>{advice.umbrella}</span>
				</p>

				<!-- Tatlong bloke ng payo: isusuot / paglilibot / dadalhin -->
				<div class="mt-6 space-y-4">
					{adviceBlocks.map((block) => (
						<div class="rounded-2xl border border-pine-100 bg-white p-4 sm:p-5">
							<p class="flex items-center gap-2 text-[0.7rem] sm:text-xs font-bold uppercase tracking-[0.16em] text-pine-700 mb-2.5">
								<span aria-hidden="true">{block.icon}</span> {block.title}
							</p>
							<ul
								class="space-y-2 text-sm sm:text-[15px] text-slate-800 leading-relaxed list-disc list-outside ms-5"
								data-weather-list={block.key}
							>
								{block.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))}
				</div>

				<p class="mt-5 text-[0.7rem] sm:text-xs text-slate-500 leading-relaxed">
					Datos na pang-meteorolohiya na nakolekta para sa mga coordinate ng parke.
					<span data-weather-updated>{(updatedLabel && `Huling na-update: ${updatedLabel}`) || ''}</span>
					Ang mga halaga ay maaaring magbago — suriin muli bago magbiyahe.
				</p>
			</div>

			<!-- 2. Pitong araw na pagtataya -->
			<div class="lg:col-span-7 card p-6 sm:p-8 border border-pine-100 shadow-card">
				<div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700">Pitong Araw na Pagtataya</p>
					<p class="text-xs text-slate-500">{ENTITY.cityName}, {ENTITY.stateProvince}</p>
				</div>

				<div class="overflow-x-auto -mx-1 px-1">
					<table class="w-full min-w-[560px] text-left border-collapse">
						<thead>
							<tr class="text-[0.7rem] uppercase tracking-wider text-slate-500 border-b border-slate-200">
								<th class="py-2 pr-3 font-semibold">Araw</th>
								<th class="py-2 pr-3 font-semibold">Lagay</th>
								<th class="py-2 pr-3 font-semibold">Taas / Baba</th>
								<th class="py-2 pr-3 font-semibold">Tsansa ng ulan</th>
								<th class="py-2 pr-3 font-semibold">UV</th>
								<th class="py-2 font-semibold">Payo sa araw</th>
							</tr>
						</thead>
						<tbody>
							{snapshot.daily.map((day, i) => {
								const info = describeCode(day.code);
								return (
									<tr class="border-b border-slate-100 last:border-0" data-day-row={i}>
										<td class="py-3 pr-3 align-top">
											<p class="font-bold text-pine-950 text-sm" data-day-label>{dayLabel(day.date, i)}</p>
											<p class="text-[0.7rem] text-slate-500">{dateLabel(day.date)}</p>
										</td>
										<td class="py-3 pr-3 align-top">
											<p class="text-lg leading-none" aria-hidden="true" data-day-icon>{info.icon}</p>
											<p class="text-[0.7rem] text-slate-600" data-day-desc>{info.label}</p>
										</td>
										<td class="py-3 pr-3 align-top text-sm whitespace-nowrap">
											<span class="font-bold text-pine-950" data-day-max>{day.max}°</span>
											<span class="text-slate-500" data-day-min> / {day.min}°</span>
										</td>
										<td class="py-3 pr-3 align-top text-sm">
											<span class="font-semibold text-slate-700" data-day-pop>{day.pop}%</span>
											<p class="text-[0.7rem] text-slate-500">{day.sum} mm</p>
										</td>
										<td class="py-3 pr-3 align-top text-sm font-semibold text-slate-700">{day.uv}</td>
										<td class="py-3 align-top text-[0.7rem] sm:text-xs text-pine-800" data-day-hint>{buildDayHint(day.code, day.pop, day.min, day.max)}</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>

				<p class="mt-4 text-[0.7rem] sm:text-xs text-slate-500 leading-relaxed">
					Ang mga numero sa itaas ay ina-update kapag binuksan ang pahina. Para sa opisyal na babala ng
					bagyo at malakas na ulan, sumangguni sa pambansang tanggapan ng meteorolohiya ng Pilipinas bago
					magbiyahe patungong Baguio.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	import {
		buildAdvice,
		buildDayHint,
		describeCode,
		feelPhrase,
		uvPhrase,
		windPhrase,
		WEATHER_ENDPOINT_PREFIX,
	} from '../lib/weather-advisory';

	const root = document.querySelector('[data-weather-root]') as HTMLElement | null;
	if (root) {
		const query = root.dataset.weatherQuery || '';

		const setText = (attr: string, value: string) => {
			const el = root.querySelector(`[data-weather-${attr}]`);
			if (el) el.textContent = value;
		};

		const setList = (name: string, items: string[]) => {
			const list = root.querySelector(`[data-weather-list="${name}"]`);
			if (!list) return;
			list.replaceChildren(
				...items.map((text) => {
					const li = document.createElement('li');
					li.textContent = text;
					return li;
				})
			);
		};

		const paint = (json: any) => {
			const c = json?.current;
			const d = json?.daily;
			if (!c || !d || !Array.isArray(d.time)) return;

			const today = {
				code: Number(d.weather_code?.[0] ?? 3),
				max: Math.round(d.temperature_2m_max?.[0] ?? 0),
				min: Math.round(d.temperature_2m_min?.[0] ?? 0),
				pop: Math.round(d.precipitation_probability_max?.[0] ?? 0),
				sum: Number(d.precipitation_sum?.[0] ?? 0),
				uv: Number(d.uv_index_max?.[0] ?? 0),
			};

			const facts = {
				code: Number(c.weather_code ?? today.code),
				temp: Math.round(c.temperature_2m ?? today.max),
				apparent: Math.round(c.apparent_temperature ?? c.temperature_2m ?? today.max),
				humidity: Math.round(c.relative_humidity_2m ?? 75),
				wind: Math.round(c.wind_speed_10m ?? 0),
				gust: Math.round(c.wind_gusts_10m ?? c.wind_speed_10m ?? 0),
				precip: Number(c.precipitation ?? 0),
				pop: today.pop,
				sum: today.sum,
				uv: Number(c.uv_index ?? today.uv),
				max: today.max,
				min: today.min,
			};

			const advice = buildAdvice(facts);
			const info = describeCode(facts.code);
			const wind = Math.max(facts.wind, facts.gust);

			setText('icon', info.icon);
			setText('temp', String(facts.temp));
			setText('desc', info.label);
			setText('apparent', String(facts.apparent));
			setText('feel', feelPhrase(facts.apparent));
			setText('pop', String(facts.pop));
			setText('wind', windPhrase(wind));
			setText('uv', uvPhrase(facts.uv));
			setText('headline', advice.headline);
			setText('umbrella', advice.umbrella);

			setList('outfit', advice.outfit);
			setList('plan', advice.plan);
			setList('gear', advice.gear);

			const alertsBox = root.querySelector('[data-weather-alerts]') as HTMLElement | null;
			const alertsList = root.querySelector('[data-weather-alerts-list]');
			if (alertsBox && alertsList) {
				alertsBox.hidden = advice.alerts.length === 0;
				alertsList.replaceChildren(
					...advice.alerts.map((text) => {
						const li = document.createElement('li');
						li.textContent = text;
						return li;
					})
				);
			}

			root.querySelectorAll('[data-day-row]').forEach((row, i) => {
				if (d.time[i] === undefined) return;
				const code = Number(d.weather_code?.[i] ?? 3);
				const pop = Math.round(d.precipitation_probability_max?.[i] ?? 0);
				const hourly = describeCode(code);
				const iconEl = row.querySelector('[data-day-icon]');
				const descEl = row.querySelector('[data-day-desc]');
				const maxEl = row.querySelector('[data-day-max]');
				const minEl = row.querySelector('[data-day-min]');
				const popEl = row.querySelector('[data-day-pop]');
				const hintEl = row.querySelector('[data-day-hint]');
				if (iconEl) iconEl.textContent = hourly.icon;
				if (descEl) descEl.textContent = hourly.label;
				if (maxEl) maxEl.textContent = `${Math.round(d.temperature_2m_max?.[i] ?? 0)}°`;
				if (minEl) minEl.textContent = ` / ${Math.round(d.temperature_2m_min?.[i] ?? 0)}°`;
				if (popEl) popEl.textContent = `${pop}%`;
				if (hintEl) {
					hintEl.textContent = buildDayHint(
						code,
						pop,
						Math.round(d.temperature_2m_min?.[i] ?? 0),
						Math.round(d.temperature_2m_max?.[i] ?? 0)
					);
				}
			});

			const updatedEl = root.querySelector('[data-weather-updated]');
			if (updatedEl && typeof c.time === 'string') {
				const when = new Date(c.time);
				if (!Number.isNaN(when.getTime())) {
					updatedEl.textContent =
						'Huling na-update: ' +
						when.toLocaleString('fil-PH', {
							month: 'long',
							day: 'numeric',
							hour: '2-digit',
							minute: '2-digit',
							timeZone: 'Asia/Manila',
						});
				}
			}
		};

		let endpoint = '';
		try {
			endpoint = atob(WEATHER_ENDPOINT_PREFIX) + query;
		} catch {
			endpoint = '';
		}

		if (endpoint) {
			fetch(endpoint)
				.then((res) => (res.ok ? res.json() : Promise.reject(new Error('bad response'))))
				.then(paint)
				.catch(() => {
					/* Mananatili ang impormasyong nakuha sa server. */
				});
		}
	}
</script>
