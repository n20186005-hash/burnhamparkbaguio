---
import '../styles/global.css';
import { SITE } from '../consts';
import GA4 from '../components/GA4.astro';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	structuredData?: Record<string, unknown>;
	lang?: string;
	noIndex?: boolean;
}

const {
	title,
	description,
	ogImage,
	ogImageAlt,
	ogType,
	structuredData,
	lang = SITE.language,
	noIndex = false,
} = Astro.props;

const mobileNav = [
	{ label: 'Mapa', href: '/#mapa', icon: '🗺️' },
	{ label: 'Pagbiyahe', href: '/pagbiyahe/', icon: '🚌' },
	{ label: 'Plano', href: '/plano/', icon: '📝' },
	{ label: 'FAQ', href: '/faq/', icon: '❓' },
] as const;
---

<!doctype html>
<html lang={lang} dir="ltr" class="scroll-pt-20">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			ogType={ogType}
			structuredData={structuredData}
		/>
		{noIndex && <meta name="robots" content="noindex,nofollow" />}
		<GA4 />
	</head>
	<body class="min-h-screen flex flex-col bg-slate-50 font-sans text-slate-900 antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-2xl focus:bg-pine-900 focus:px-5 focus:py-3 focus:text-white focus:shadow-card"
		>
			Laktawan patungo sa pangunahing nilalaman
		</a>

		<Navbar />

		<main id="main-content" class="flex-1">
			<slot />
		</main>

		<!-- Mobile Bottom Quick Navigation -->
		<nav
			aria-label="Mabilis na nabigasyon sa mobile"
			class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-cold-200 bg-white/95 backdrop-blur-md safe-bottom"
		>
			<ul class="grid grid-cols-4 gap-1 px-2 py-2">
				{
					mobileNav.map((n) => (
						<li>
							<a
								href={n.href}
								class="flex flex-col items-center justify-center gap-0.5 rounded-xl px-2 py-2 text-[11px] sm:text-xs font-semibold text-cold-700 hover:bg-pine-50 hover:text-pine-900 transition-colors"
							>
								<span class="text-lg leading-none" aria-hidden="true">{n.icon}</span>
								<span>{n.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="lg:hidden h-16 safe-bottom-spacer" aria-hidden="true"></div>

		<Footer />
	</body>
</html>
