---
import DetailLayout from '../../layouts/DetailLayout.astro';
import { PAGE_META, KEY_INFO, PAID_ACTIVITIES, OFFICIAL_SOURCES } from '../../consts';

const meta = PAGE_META.openingHours;

const libres = PAID_ACTIVITIES.filter((a) => a.bayad === 'LIBRE');
const bayad = PAID_ACTIVITIES.filter((a) => a.bayad !== 'LIBRE');

const nightTips = [
	{
		title: 'Piliin ang mga lugar na may ilaw at maraming tao',
		desc: 'Ang paligid ng lagoon at ang mga pangunahing daanan ay may ilaw at palaging may naglalakad. Iwasan ang mga daang walang ilaw at mga shortcut sa loob ng parke.',
	},
	{
		title: 'Maglakad nang may kasama',
		desc: 'Tulad ng anumang pampublikong lugar sa lungsod, mas ligtas kapag may kasama — lalo na kapag lampas alas-nuwebe na ng gabi.',
	},
	{
		title: 'Huwag lumangoy o lumusong sa lawa',
		desc: 'Ang Burnham Lagoon ay hindi dinisenyo para sa paglangoy. Madilim ang tubig, hindi pantay ang ilalim, at ipinagbabawal ito upang mapanatili ang kalinisan ng lawa.',
	},
	{
		title: 'Bantayan ang huling biyahe',
		desc: 'Limitado ang jeepney at taxi sa kalaliman ng gabi. Kung maglalakad ka pabalik sa hotel, alamin muna kung gaano ito kalayo — gamitin ang mga distansya sa aming gabay sa transportasyon.',
	},
];

const bestTimes = [
	{
		window: '6:00–9:00 ng umaga',
		why: 'Pinakatahimik, pinakamalamig, at pinakamalinis na hangin. Pinakamaganda ring liwanag para sa litrato sa Rose Garden at lagoon.',
		crowd: 'Kakaunting tao',
	},
	{
		window: '9:00–11:00 ng umaga',
		why: 'Bukas na ang mga operator ng bangka at upa ng bisikleta. Hindi pa mainit at hindi pa siksikan ang Session Road.',
		crowd: 'Katamtaman',
	},
	{
		window: '11:00–15:00 ng tanghali',
		why: 'Pinakamaraming tao at pinakamainit na bahagi ng araw. Mainam para sa mga kainan sa Session Road o pagpapahinga sa lilim ng mga pine.',
		crowd: 'Maraming tao',
	},
	{
		window: '16:00–18:00 ng hapon',
		why: 'Magandang tanawin sa Melvin Jones Grandstand at ginintuang liwanag sa lawa. Mainam para sa piknik at paglalakad ng pamilya.',
		crowd: 'Katamtaman hanggang marami',
	},
	{
		window: '18:00–21:00 ng gabi',
		why: 'Ang parke ay bukas pa rin — tamang oras para sa tahimik na paglalakad malapit sa mga lugar na may ilaw.',
		crowd: 'Pabilis nang kaunti ang tao',
	},
	{
		window: '21:00–madaling araw',
		why: 'Bukas pa rin ang parke, ngunit kaunti na ang tao. Para lamang sa mga sanay maglakad sa lungsod at may kasama.',
		crowd: 'Kakaunting tao',
	},
];

const faqs = [
	{
		q: 'May entrance fee ba ang Burnham Park?',
		a: 'Wala. Libre ang pagpasok sa lahat ng bahagi ng parke — lagoon, Rose Garden, Melvin Jones Grandstand, Igorot Garden, Orchidarium, at Athletic Bowl. Walang ticket booth sa mga pasukan.',
	},
	{
		q: 'Bukas ba ang Burnham Park 24 oras?',
		a: 'Oo. Ang parke ay bukas araw-araw, 24 oras. Hindi nagsasara ang mga pasukan. Gayunpaman, ang mga aktibidad na pinapatakbo ng mga concessionaire (pamamangka, upa ng bisikleta, skating) ay may sariling oras ng operasyon — karaniwang hanggang gabi lamang.',
	},
	{
		q: 'Anong oras nagsasara ang Burnham Park sa gabi?',
		a: 'Walang oras ng pagsasara ang parke. Ang dapat mong bantayan ay ang mga serbisyo sa paligid: karamihan ng mga tindahan ng upa ng bisikleta at boat station ay nagsasara pagdating ng gabi, at ang mga palikuran ay maaaring limitado ang oras.',
	},
	{
		q: 'Anong oras bukas ang bike rental sa Burnham Park?',
		a: 'Nakadepende ito sa operator. Karamihan ay nagbubukas bandang umaga at nagsasara pagdating ng gabi, na mas maaga kapag tag-ulan o kapag tahimik ang parke. Pinakaligtas na plano: umupa bago mag-alas-singko ng hapon.',
	},
	{
		q: 'Magkano ang pamamangka sa Burnham Lagoon?',
		a: 'May bayad ang pamamangka, ngunit walang iisang opisyal na rate card na nakapaskil — itinatakda ito ng mga concessionaire at nagbabago depende sa panahon at uri ng sasakay. Itanong ang eksaktong presyo sa boat station bago sumakay, at maghanda ng eksaktong pera.',
	},
	{
		q: 'Puwede bang pumasok sa parke tuwing may bagyo o malakas na ulan?',
		a: 'Hindi isinasara ang parke, ngunit hindi ito inirerekomenda. Tuwing habagat at malakas na ulan ay maaaring ipagpaliban o suspindihin ang pamamangka, madulas ang mga daanan, at may panganib na pagguho ng lupa sa mga kalsadang paakyat papuntang Baguio. Suriin muna ang opisyal na babala ng PAGASA bago magbiyahe.',
	},
	{
		q: 'May bayad ba ang paggamit ng palikuran sa parke?',
		a: 'Oo, karaniwang may maliit na bayad ang mga pampublikong palikuran — magdala ng barya. Limitado ang oras ng ilan sa mga ito, kaya gamitin ang mga palikuran malapit sa mga pangunahing pasukan at sa paligid ng lagoon habang marami pang tao.',
	},
] as const;

const official = OFFICIAL_SOURCES.filter((s) => s.url.startsWith('http'));
---

<DetailLayout
	title={meta.title}
	description={meta.description}
	hero={meta.hero}
	heroAlt={meta.heroAlt}
	eyebrow={meta.eyebrow}
	h1="Oras ng pagbubukas at bayad sa Burnham Park"
	intro="Ang Burnham Park ay bukas 24 oras araw-araw at LIBRE ang pagpasok. Walang ticket booth, walang entrance fee. Ang tanging mga gastos ay ang mga aktibidad na pinapatakbo ng mga concessionaire sa loob ng parke — pamamangka, upa ng bisikleta, skating, at pony ride."
	slug="opening-hours"
	faqs={faqs}
>
	<!-- 1. Mabilisang sagot -->
	<section class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
		{KEY_INFO.map((k) => (
			<div class="card p-4 sm:p-5">
				<p class="text-[0.7rem] uppercase tracking-wider text-slate-500 font-semibold">{k.label}</p>
				<p class="mt-1 text-xl sm:text-2xl font-bold text-pine-950 leading-tight">{k.value}</p>
				<p class="mt-1 text-xs text-slate-600">{k.sub}</p>
			</div>
		))}
	</section>

	<!-- 2. Libre vs may bayad -->
	<section class="mt-12 sm:mt-14" id="bayad">
		<div class="max-w-3xl mb-6 sm:mb-8">
			<span class="eyebrow">🎟️ Libre at May Bayad</span>
			<h2 class="text-balance">Alin ang libre at alin ang babayaran sa loob ng parke</h2>
			<p class="mt-3 text-slate-700 leading-relaxed">
				Ito ang pinakamadalas na tanong ng mga unang beses na bisita: libre ba ang Burnham Park? Oo —
				ang pagpasok at paglibot sa parke ay walang bayad. Ang mga sumusunod lamang ang may kaukulang gastos.
			</p>
		</div>

		<div class="overflow-x-auto -mx-1 px-1">
			<table class="w-full min-w-[620px] text-left border-collapse text-sm">
				<thead>
					<tr class="text-[0.7rem] uppercase tracking-wider text-slate-500 border-b border-slate-200">
						<th class="py-2 pr-4 font-semibold">Aktibidad</th>
						<th class="py-2 pr-4 font-semibold">Saan</th>
						<th class="py-2 pr-4 font-semibold">Bayad</th>
						<th class="py-2 font-semibold">Dapat mong malaman</th>
					</tr>
				</thead>
				<tbody>
					{libres.map((a) => (
						<tr class="border-b border-slate-100 bg-pine-50/50">
							<td class="py-3 pr-4">
								<span class="font-semibold text-pine-950">{a.icon} {a.name}</span>
							</td>
							<td class="py-3 pr-4 text-slate-600">{a.saan}</td>
							<td class="py-3 pr-4">
								<span class="inline-block rounded-full bg-pine-700 px-2.5 py-1 text-[0.7rem] font-bold text-white">{a.bayad}</span>
							</td>
							<td class="py-3 text-slate-600 leading-relaxed">{a.note}</td>
						</tr>
					))}
					{bayad.map((a) => (
						<tr class="border-b border-slate-100 last:border-0">
							<td class="py-3 pr-4">
								<span class="font-semibold text-slate-800">{a.icon} {a.name}</span>
							</td>
							<td class="py-3 pr-4 text-slate-600">{a.saan}</td>
							<td class="py-3 pr-4">
								<span class="inline-block rounded-full bg-amber-500 px-2.5 py-1 text-[0.7rem] font-bold text-white">{a.bayad}</span>
							</td>
							<td class="py-3 text-slate-600 leading-relaxed">{a.note}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<p class="mt-4 text-xs sm:text-sm text-slate-500 leading-relaxed">
			Bakit walang nakalagay na eksaktong halaga? Ang mga bayad sa loob ng parke ay itinatakda ng bawat
			concessionaire at nagbabago depende sa uri ng sasakay, haba ng oras, at panahon (mas mataas o mas mahaba ang
			pila tuwing Panagbenga at Kapaskuhan). Mas gusto naming sabihin ang totoo kaysa maglimbag ng numerong maaaring
			luma na pagdating mo. Gamitin ang gabay na ito bilang checklist: alamin kung alin ang libre, at direktang
			magtanong sa operator.
		</p>
	</section>

	<!-- 3. Pinakamagandang oras -->
	<section class="mt-12 sm:mt-14" id="oras">
		<div class="max-w-3xl mb-6 sm:mb-8">
			<span class="eyebrow">🕒 Oras ng Araw</span>
			<h2 class="text-balance">Anong oras pinakamainam pumunta</h2>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			{bestTimes.map((t) => (
				<div class="card p-5">
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="font-bold text-pine-950">{t.window}</h3>
						<span class="chip shrink-0">{t.crowd}</span>
					</div>
					<p class="mt-2 text-sm text-slate-600 leading-relaxed">{t.why}</p>
				</div>
			))}
		</div>
	</section>

	<!-- 4. Pagbisita sa gabi -->
	<section class="mt-12 sm:mt-14" id="gabi">
		<div class="max-w-3xl mb-6 sm:mb-8">
			<span class="eyebrow">🌙 Bukas ba sa Gabi?</span>
			<h2 class="text-balance">Ligtas bang maglakad sa Burnham Park pagdating ng gabi</h2>
			<p class="mt-3 text-slate-700 leading-relaxed">
				Oo, bukas ang parke 24 oras at may mga nagpapatrolyang security guard. Ngunit ang accommodation at
				transportasyon ay may oras — kaya narito ang mga dapat tandaan kung gagabihin ka sa parke.
			</p>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			{nightTips.map((t) => (
				<div class="card p-5 flex items-start gap-4">
					<span class="mt-0.5 text-pine-700 font-bold" aria-hidden="true">✓</span>
					<div>
						<h3 class="font-bold text-pine-950 mb-1.5">{t.title}</h3>
						<p class="text-sm text-slate-600 leading-relaxed">{t.desc}</p>
					</div>
				</div>
			))}
		</div>
		<p class="mt-4 text-sm text-slate-600">
			Kailangan mo bang malaman kung gaano kalayo ang lakad pabalik sa iyong hotel? Tingnan ang
			<a href="/how-to-get-there/" class="text-pine-700 font-semibold underline">mga distansya at ruta papuntang parke</a>.
		</p>
	</section>

	<!-- 5. Opisyal na sanggunian -->
	<section class="mt-12 sm:mt-14">
		<div class="rounded-[1.5rem] border border-pine-100 bg-white/80 p-5 sm:p-6">
			<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-3">🏛️ Mga Opisyal na Sanggunian</p>
			<p class="text-sm text-slate-700 leading-relaxed mb-4">
				Ang mga oras at serbisyo ay maaaring magbago dahil sa mga kaganapan ng lungsod o babala ng panahon.
				Para sa opisyal na impormasyon, sumangguni sa mga sumusunod（binubuksan sa bagong tab）:
			</p>
			<ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm">
				{official.map((s) => (
					<li>
						<a
							href={s.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-start gap-2 font-semibold text-pine-800 underline underline-offset-4 decoration-pine-300 hover:text-pine-950 hover:decoration-pine-600"
						>
							<span aria-hidden="true">🔗</span>
							<span>{s.title}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</DetailLayout>
