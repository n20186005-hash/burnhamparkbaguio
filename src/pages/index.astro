---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeyInfoCard from '../components/KeyInfoCard.astro';
import ClusterCard from '../components/ClusterCard.astro';
import {
	SITE, NAV, CLUSTERS, CLUSTER_CATEGORIES, KEY_INFO, PAGE_META, PAGE_IMAGES,
	HISTORY_TIMELINE, LEGENDS, ACTIVITIES, FOOD_TYPES, ACCOMMODATION_TYPES,
	NEARBY_ATTRACTIONS, PRACTICAL_INFO, TRANSPORT_OPTIONS, TIPS, FAQS,
	SEASONS, GALLERY_IMAGES, DISCLAIMER,
} from '../consts';

const meta = PAGE_META.home;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'TouristAttraction',
			'@id': `${SITE.siteUrl}/#park`,
			name: 'Burnham Park (Burnham Park Reservation)',
			alternateName: ['Burnham Park Baguio', 'Burnham Park Reservation'],
			description: meta.description,
			url: SITE.siteUrl,
			image: [meta.hero],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Jose Abad Santos Drive',
				addressLocality: 'Baguio',
				addressRegion: 'Benguet',
				postalCode: '2600',
				addressCountry: { '@type': 'Country', name: 'PH' },
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: SITE.coordinates.lat,
				longitude: SITE.coordinates.lng,
			},
			openingHoursSpecification: [{
				'@type': 'OpeningHoursSpecification',
				dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
				opens: '00:00', closes: '23:59',
			}],
			priceRange: 'Free',
			wheelchairAccessible: true,
			touristType: ['Pamilya', 'Magkapareha', 'Bakasyonista', 'Mahilig sa kasaysayan'],
			sameAs: ['https://en.wikipedia.org/wiki/Burnham_Park_(Baguio)'],
		},
		{
			'@type': 'WebSite',
			name: SITE.name,
			url: SITE.siteUrl,
			inLanguage: 'fil',
			publisher: { '@type': 'Organization', name: SITE.author },
			potentialAction: {
				'@type': 'SearchAction',
				target: `${SITE.siteUrl}/?s={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		},
	],
};
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	ogImage={meta.hero}
	ogImageAlt={meta.heroAlt}
	ogType="website"
	structuredData={structuredData}
	lang="fil"
>
	<!-- =================================================================== -->
	<!-- 1. HERO                                                             -->
	<!-- =================================================================== -->
	<section aria-label="Unang panauhin" class="relative bg-pine-950">
		<div class="relative w-full h-[480px] sm:h-[520px] md:h-[560px] overflow-hidden">
			<img
				src={meta.hero}
				alt={meta.heroAlt}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover"
				style="border-radius:0"
			/>
			<div class="absolute inset-0 hero-overlay"></div>
			<div class="absolute inset-0">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center sm:justify-end pb-10 sm:pb-16 md:pb-20">
					<span class="eyebrow text-white/90" style="text-shadow:0 2px 12px rgba(0,0,0,0.4)">
						{meta.eyebrow}
					</span>
					<h1 class="text-balance text-white font-bold tracking-tight max-w-4xl mb-4 sm:mb-5" style="text-shadow:0 6px 40px rgba(0,0,0,0.55)">
						Burnham Park — Luntiang Puso ng Lungsod ng Baguio
					</h1>
					<p class="pretty text-white/90 max-w-2xl text-base sm:text-xl md:text-2xl leading-relaxed mb-6 sm:mb-8" style="text-shadow:0 2px 18px rgba(0,0,0,0.5)">
						{meta.description}
					</p>
					<div class="flex flex-col sm:flex-row items-stretch sm:items-start gap-3 sm:gap-4 max-w-3xl">
						<a href="#tungkol" class="btn-primary btn-wide">
							Tuklasin ang Parke
							<span aria-hidden="true">→</span>
						</a>
						<a href="#mapa" class="btn-secondary btn-wide !bg-white/10 !border-white/25 !text-white hover:!bg-white/20 backdrop-blur-sm">
							🗺️ Tingnan ang Mapa
						</a>
					</div>
					<div class="mt-8 sm:mt-10 flex flex-wrap gap-2 sm:gap-3">
						{KEY_INFO.map((k) => (
							<span class="chip !bg-white/10 !text-white !border-white/20 backdrop-blur-sm">
								<strong class="font-bold mr-1">{k.value}</strong>
								<span class="text-white/80">· {k.label}</span>
							</span>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. QUICK INFO CARDS (floating) -->
	<KeyInfoCard />

	<!-- =================================================================== -->
	<!-- 3. TUNGKOL (About)                                                  -->
	<!-- =================================================================== -->
	<section class="section-pad" aria-label="Tungkol sa Burnham Park" id="tungkol">
		<div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
			<div class="lg:col-span-7">
				<span class="eyebrow">Tungkol sa Burnham Park</span>
				<h2 class="text-balance mb-6">
					Isang 32.84-ektaryang parke na inihanda ni Daniel Burnham, na nasa dating lupain ng mga Ibaloi.
				</h2>
				<div class="prose-fil !max-w-none">
					<p>
						Ang <strong>Burnham Park</strong> ay ang pinakasikat at pinakamahalagang pampublikong
						parke ng <strong>Lungsod ng Baguio</strong>, ang tinaguriang Summer Capital ng Pilipinas.
						Nasa gitna ito ng lungsod, katabi ng Session Road at Baguio Public Market — kaya madali itong puntahan mula saan mang dako ng sentro.
					</p>
					<p>
						Dinisenyo ito ng tanyag na Amerikanong arkitekto at tagaplano ng lungsod na si
						<strong>Daniel Hudson Burnham</strong> noong 1905, bilang sentrong luntiang bahagi ng kanyang
						plano para sa Baguio. Itinayo ito sa dating parang ng <em>Kafagway</em>, ang orihinal na
						pamayanan ng mga katutubong <strong>Ibaloi</strong> bago ang panahon ng mga Amerikano.
					</p>
					<p>
						Sa ngayon, ang Burnham Park ay pinamamahalaan ng <strong>Lungsod ng Baguio</strong> at bukas
						para sa lahat nang <strong>WALANG BAYAD</strong>. Para sa mga pamilya, magkapareha, o mga
						lokal na naghahanap ng sariwang hangin — ito ang pinaka-paboritong pampublikong lugar sa
						buong Cordillera.
					</p>
				</div>
			</div>
			<div class="lg:col-span-5 space-y-4">
				<div class="card overflow-hidden p-0">
					<div class="relative aspect-[4/3]">
						<img
							src={PAGE_IMAGES.aboutPark}
							alt={PAGE_IMAGES.aboutParkAlt}
							class="h-full w-full object-cover"
							style="border-radius:0"
							loading="lazy"
						/>
					</div>
					<div class="p-5 sm:p-6">
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-2">📊 Mabilis na Talaan</p>
						<dl class="divide-y divide-slate-100">
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Sukat ng Parke</dt>
								<dd class="font-semibold text-pine-900">32.84 ektarya (81.1 akre)</dd>
							</div>
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Taon dinisenyo</dt>
								<dd class="font-semibold text-pine-900">1905 (Burnham Plan)</dd>
							</div>
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Taon itinalaga</dt>
								<dd class="font-semibold text-pine-900">1925 (Proc. Blg. 64)</dd>
							</div>
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Taas ng lokasyon</dt>
								<dd class="font-semibold text-pine-900">~1,500 m (ibabaw ng dagat)</dd>
							</div>
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Bilang ng mga puno</dt>
								<dd class="font-semibold text-pine-900">~2,600 na puno, 72 uri</dd>
							</div>
							<div class="flex items-center justify-between py-2.5">
								<dt class="text-slate-600 text-sm">Kabuuan ng mga sona</dt>
								<dd class="font-semibold text-pine-900">12 na pangunahing bahagi</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 4. KASAYSAYAN (History Timeline)                                     -->
	<!-- =================================================================== -->
	<section class="section-pad surface-pine" aria-label="Kasaysayan ng Burnham Park" id="kasaysayan">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">📜 Kasaysayan at Pamana</span>
				<h2 class="text-balance mb-5">
					Mula Kafagway hanggang Burnham Park — mahigit 120 taon ng kasaysayan.
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Si <strong>Daniel Hudson Burnham</strong> (1846–1912) ay isa sa pinakamakapangyarihang
					tagaplano ng lungsod sa Amerika. Noong 1904, inimbitahan siya sa Pilipinas upang gumawa
					ng plano para sa Maynila at Baguio — at ang Burnham Park ang naging "green heart" ng
					kanyang plano. Narito ang mahalagang mga pangyayari sa kasaysayan ng parke:
				</p>
			</div>

			<ol class="relative border-s-2 border-pine-300 ms-3 sm:ms-5">
				{HISTORY_TIMELINE.map((t, i) => (
					<li class="mb-10 ms-6 sm:ms-10 last:mb-0">
						<span class="absolute -start-[22px] sm:-start-[30px] mt-1.5 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-pine-800 text-white text-xs sm:text-sm font-bold shadow-soft ring-4 ring-cold-50">
							{i + 1}
						</span>
						<time class="mb-1 block text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-rose-sand-700">
							{t.year}
						</time>
						<h3 class="text-xl sm:text-2xl font-bold text-pine-950 mb-2 leading-tight">{t.title}</h3>
						<p set:html={t.desc} class="text-slate-700 leading-relaxed"></p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 5. LEGENDS & HERITAGE                                                -->
	<!-- =================================================================== -->
	<section class="section-pad" aria-label="Mga Alamat at Pamana" id="alamat">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">📖 Pamana at Kahalagahan</span>
				<h2 class="text-balance mb-5">
					Ang kuwento ng mga Ibaloi, ang Kafagway, at ang City Beautiful Movement.
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Ang Burnham Park ay higit pa sa isang parke — ito ay buhay na bahagi ng kasaysayan
					ng Cordillera.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{LEGENDS.map((l) => (
					<div class="card p-6 sm:p-8 flex flex-col items-start">
						<span class="text-4xl mb-4" aria-hidden="true">{l.icon}</span>
						<h3 class="text-lg sm:text-xl font-bold text-pine-950 mb-3">{l.title}</h3>
						<p set:html={l.desc} class="text-sm text-slate-700 leading-relaxed"></p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 6. MGA ATRAKSYON (12 Clusters)                                      -->
	<!-- =================================================================== -->
	<section class="section-pad surface-pine" aria-label="12 na sona ng Burnham Park" id="atraksyon">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">📐 12 Bahagi ng Parke</span>
				<h2 class="text-balance mb-5">
					Mula sa Lagoon hanggang Pine Grove — tuklasin ang bawat sulok ng Burnham Park.
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Ang Burnham Park ay hindi iisang malawak na damuhan lamang. Hinati ito sa 12 na
					magkakaibang <em>cluster</em> — mula sa lawa, hardin ng rosas, palaruan para sa mga bata,
					hanggang sa malawak na parang para sa Panagbenga. Narito ang bawat isa:
				</p>
			</div>

			<!-- Category Filter -->
			<div class="mb-8 sm:mb-10 flex flex-wrap items-center gap-2 sm:gap-3" role="tablist" aria-label="Filter ng 12 bahagi ng parke">
				{CLUSTER_CATEGORIES.map((cat) => (
					<button
						type="button" role="tab"
						aria-selected={cat.id === 'all'}
						data-cluster-filter={cat.id}
						class:list={[
							'inline-flex items-center rounded-full border px-4 sm:px-5 py-2 text-sm sm:text-[15px] font-semibold transition-colors duration-200 no-print',
							cat.id === 'all'
								? 'bg-pine-900 text-white border-pine-900 shadow-soft'
								: 'bg-white text-pine-800 border-pine-200 hover:bg-pine-50',
						]}
					>
						{cat.label}
					</button>
				))}
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-cluster-grid>
				{CLUSTERS.map((cluster) => <ClusterCard cluster={cluster} />)}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 7. MGA GAWAIN (Activities) — mga uri lamang, walang komersyal       -->
	<!-- =================================================================== -->
	<section class="section-pad" aria-label="Mga aktibidad sa Burnham Park" id="gawain">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">⚽ Mga Aktibidad</span>
				<h2 class="text-balance mb-5">
					Ano ang maaaring gawin sa loob ng Burnham Park?
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Maraming aktibidad na puwedeng subukan — mula sa pamamangka sa lagoon, pagbibisikleta,
					hanggang sa tahimik na pagkuha ng litrato. Pumili ayon sa iyong hilig.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
				{ACTIVITIES.map((a) => (
					<div class="card p-6 sm:p-7 flex flex-col h-full">
						<div class="flex items-start gap-4 mb-4">
							<span class="text-3xl shrink-0" aria-hidden="true">{a.icon}</span>
							<div>
								<h3 class="text-lg font-bold text-pine-950 mb-1">{a.title}</h3>
								<p class="text-xs font-semibold uppercase tracking-[0.15em] text-pine-700">{a.type}</p>
							</div>
						</div>
						<ul class="mt-auto text-sm text-slate-700 space-y-2 list-disc list-outside ms-5">
							{a.details.map((d) => <li>{d}</li>)}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 8. PRAKTIKAL NA IMPORMASYON (Facilities & Services)                  -->
	<!-- =================================================================== -->
	<section class="section-pad surface-pine" aria-label="Praktikal na impormasyon" id="praktikal">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">ℹ️ Praktikal na Impormasyon</span>
				<h2 class="text-balance mb-5">
					Mga pasilidad, serbisyo, at mahalagang impormasyon para sa iyong pagbisita.
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
				{PRACTICAL_INFO.map((p) => (
					<div class="card p-5 sm:p-6 flex items-start gap-4">
						<span class="text-3xl shrink-0" aria-hidden="true">{p.icon}</span>
						<div>
							<h3 class="font-bold text-pine-950 mb-1.5">{p.title}</h3>
							<p class="text-sm text-slate-600 leading-relaxed">{p.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 9. PAGKAIN (Food Types) — uri lamang, walang tiyak na kainan        -->
	<!-- =================================================================== -->
	<section class="section-pad" aria-label="Mga uri ng pagkain malapit sa parke" id="pagkain">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">🍽️ Pagkain at Meryenda</span>
				<h2 class="text-balance mb-5">
					Anong klaseng pagkain ang makikita sa paligid ng Burnham Park?
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Ang Baguio ay kilala sa masasarap at abot-kayang pagkain — mula sa street food
					hanggang sa tunay na lutuing Cordilleran. Narito ang mga uri ng pagkain na matitikman
					mo sa paligid ng parke, nang hindi nagrerekomenda ng partikular na kainan.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
				{FOOD_TYPES.map((f) => (
					<div class="card p-5 sm:p-6 flex items-start gap-4">
						<span class="text-3xl shrink-0" aria-hidden="true">{f.icon}</span>
						<div>
							<h3 class="font-bold text-pine-950 mb-1.5">{f.title}</h3>
							<p class="text-sm text-slate-600 leading-relaxed">{f.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 10. MATUTULUYAN (Accommodation Types) — uri lamang                   -->
	<!-- =================================================================== -->
	<section class="section-pad surface-pine" aria-label="Mga uri ng matutuluyan malapit sa parke" id="matutuluyan">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">🏨 Matutuluyan</span>
				<h2 class="text-balance mb-5">
					Saan maaaring manatili malapit sa Burnham Park?
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Maraming uri ng matutuluyan sa Baguio — mula sa walking distance na hotel hanggang sa
					budget-friendly na pension house. Narito ang mga kategorya upang makatulong sa iyong
					pagpili, nang hindi nagrerekomenda ng partikular na establisyemento.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
				{ACCOMMODATION_TYPES.map((h) => (
					<div class="card p-6 sm:p-8">
						<div class="flex items-start gap-4 mb-4">
							<span class="text-3xl shrink-0" aria-hidden="true">{h.icon}</span>
							<div>
								<h3 class="text-xl font-bold text-pine-950 mb-1">{h.title}</h3>
								<p class="text-xs font-semibold uppercase tracking-[0.15em] text-pine-700">{h.areas}</p>
							</div>
						</div>
						<p class="text-sm text-slate-700 leading-relaxed mb-5">{h.desc}</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<p class="text-xs font-bold uppercase tracking-[0.15em] text-green-700 mb-2">✅ Mga Bentahe</p>
								<ul class="text-xs text-slate-600 space-y-1 list-disc list-outside ms-4">
									{h.pros.map((p) => <li>{p}</li>)}
								</ul>
							</div>
							<div>
								<p class="text-xs font-bold uppercase tracking-[0.15em] text-rose-sand-700 mb-2">⚠️ Dapat Isaalang-alang</p>
								<ul class="text-xs text-slate-600 space-y-1 list-disc list-outside ms-4">
									{h.cons.map((c) => <li>{c}</li>)}
								</ul>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- =================================================================== -->
	<!-- 11. TRANSPORTASYON                                                   -->
	<!-- =================================================================== -->
	<section class="section-pad" aria-label="Paano pumunta sa Burnham Park" id="transportasyon">
		<div class="container-page">
			<div class="max-w-3xl mb-10 sm:mb-14">
				<span class="eyebrow">🚌 Transportasyon</span>
				<h2 class="text-balance mb-5">
					Paano pumunta sa Burnham Park mula sa kahit saang bahagi ng Baguio?
				</h2>
				<p class="text-slate-700 text-lg leading-relaxed">
					Nasa gitna ng lungsod ang Burnham Park kaya maraming paraan upang marating ito.
					Narito ang mga pangunahing opsyon:
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
				{TRANSPORT_OPTIONS.map((t) => (
					<div class="card p-5 sm:p-6 flex flex-col items-start">
						<span class="text-3xl mb-3" aria-hidden="true">{t.icon}</span>
						<h3 class="font-bold text-pine-950 mb-2">{t.title}</h3>
						<p class="text-sm text-slate-600 leading-relaxed">{t.desc}</p>
					</div>
				))}
			</div>

			<!-- Season Banner -->
			<div class="mt-12 rounded-[2rem] overflow-hidden shadow-card border border-pine-100 grid grid-cols-1 lg:grid-cols-2">
				<div class="relative aspect-[16/10] lg:aspect-auto lg:min-h-[380px]">
					<img
						src={PAGE_IMAGES.panagbenga}
						alt={PAGE_IMAGES.panagbengaAlt}
						class="h-full w-full object-cover"
						style="border-radius:0"
						loading="lazy"
					/>
				</div>
				<div class="bg-gradient-to-br from-rose-sand-5 via-cold-50 to-pine-50/60 p-8 sm:p-10 md:p-14 flex flex-col justify-center">
					<span class="eyebrow text-rose-sand-700">🌸 Panagbenga Festival</span>
					<h2 class="text-balance mb-5 text-pine-950">
						Pebrero — ang buwan ng <em>Panagbenga</em>, ang Baguio Flower Festival.
					</h2>
