<script is:inline>
	// ---- Cluster filter ------------------------------------------------
	(function () {
		const buttons = document.querySelectorAll('[data-cluster-filter]');
		const cards = document.querySelectorAll('[data-cluster-card]');
		if (!buttons.length || !cards.length) return;
		const ACTIVE = ['bg-pine-900', 'text-white', 'border-pine-900', 'shadow-soft'];
		const INACTIVE = ['bg-white', 'text-pine-800', 'border-pine-200', 'hover:bg-pine-50'];
		function activate(btn) {
			buttons.forEach(function (b) {
				b.classList.remove.apply(b.classList, ACTIVE);
				b.classList.add.apply(b.classList, INACTIVE);
				b.setAttribute('aria-selected', 'false');
			});
			btn.classList.remove.apply(btn.classList, INACTIVE);
			btn.classList.add.apply(btn.classList, ACTIVE);
			btn.setAttribute('aria-selected', 'true');
		}
		buttons.forEach(function (btn) {
			btn.addEventListener('click', function () {
				const filter = btn.getAttribute('data-cluster-filter') || 'all';
				activate(btn);
				cards.forEach(function (card) {
					const category = card.getAttribute('data-cluster-category') || '';
					const show = filter === 'all' || category === filter;
					if (show) card.removeAttribute('hidden');
					else card.setAttribute('hidden', '');
				});
			});
		});

		// ---- Smooth nav/scrolling highlight ----------------------------
		const navLinks = document.querySelectorAll('a[href^="#"]');
		navLinks.forEach(function (link) {
			link.addEventListener('click', function (e) {
				const href = this.getAttribute('href');
				if (!href || href === '#') return;
				const target = document.querySelector(href);
				if (target) {
					e.preventDefault();
					target.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});
	})();
</script>
