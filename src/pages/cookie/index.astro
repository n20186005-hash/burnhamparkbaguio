---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGE_META } from '../../consts';

const meta = PAGE_META.cookie;
const lastUpdated = 'Hulyo 2026';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: meta.title,
	description: meta.description,
	mainEntity: {
		'@type': 'CreativeWork',
		headline: 'Mga Setting ng Cookie',
		dateModified: '2026-07-01',
		author: { '@type': 'Organization', name: 'Burnham Park Baguio Guide' },
		publisher: { '@type': 'Organization', name: 'Burnham Park Baguio Guide' },
		inLanguage: 'fil',
	},
};
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	ogImage={meta.hero}
	ogImageAlt={meta.heroAlt}
	ogType="website"
	structuredData={structuredData}
	lang="fil"
>
	<!-- Hero -->
	<section aria-label="Pamagat ng pahina" class="relative bg-pine-950">
		<div class="relative w-full h-[360px] sm:h-[420px] md:h-[480px] overflow-hidden">
			<img
				src={meta.hero}
				alt={meta.heroAlt}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover"
				style="border-radius:0"
			/>
			<div class="absolute inset-0 hero-overlay"></div>
			<div class="absolute inset-0">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center sm:justify-end pb-10 sm:pb-14 md:pb-16">
					<nav aria-label="Landas ng pahina" class="mb-5 text-xs sm:text-sm">
						<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-white/70">
							<li><a href="/" class="hover:text-white underline underline-offset-4">Tahanan</a></li>
							<li aria-hidden="true" class="text-white/40">›</li>
							<li class="font-medium text-white" aria-current="page">Mga Setting ng Cookie</li>
						</ol>
					</nav>
					<span class="eyebrow text-white/90" style="text-shadow:0 2px 12px rgba(0,0,0,0.4)">
						{meta.eyebrow}
					</span>
					<h1 class="text-balance text-white font-bold tracking-tight max-w-4xl mb-3 sm:mb-4" style="text-shadow:0 6px 40px rgba(0,0,0,0.55)">
						Mga Setting ng Cookie
					</h1>
					<p class="pretty text-white/90 max-w-3xl text-base sm:text-lg leading-relaxed" style="text-shadow:0 2px 18px rgba(0,0,0,0.5)">
						Gumagamit kami ng Cookie at mga katulad na teknolohiya upang pagbutihin ang iyong karanasan sa pagba-browse. Sa pamamagitan ng panel sa ibaba, maaari mong tingnan ang gamit ng bawat uri ng Cookie at pamahalaan ang iyong mga kagustuhan.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Katawan ng pahina -->
	<section class="section-pad">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Huling pag-update -->
			<div class="card border border-pine-100 shadow-soft p-5 sm:p-6 mb-10 sm:mb-12">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm">
					<span class="inline-flex items-center gap-2 font-semibold text-pine-900">
						<span aria-hidden="true">📅</span>
						Petsa ng Huling Pag-update
					</span>
					<span class="text-slate-700 font-semibold">{lastUpdated}</span>
				</div>
			</div>

			<!-- Gabay -->
			<div class="surface-pine rounded-3xl shadow-soft border border-pine-100 p-6 sm:p-8 mb-10 sm:mb-12">
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-pine-700 mb-3">Mabilis na Talaan</p>
				<nav aria-label="Talaan ng Mga Setting ng Cookie" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm">
					<a href="#intro" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">1. Ano ang Cookie</a>
					<a href="#necessary" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">2. Kinakailangang Cookie</a>
					<a href="#analytics" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">3. Cookie para sa Pagsusuri</a>
					<a href="#preferences" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">4. Cookie para sa Kagustuhan</a>
					<a href="#marketing" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">5. Cookie para sa Pagmemerkado</a>
					<a href="#consent" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">6. Pamamahala ng Pahintulot</a>
					<a href="#how-to-manage" class="block rounded-xl px-3.5 py-2.5 bg-white/80 text-slate-800 hover:bg-white hover:text-pine-900">7. Paano Pamahalaan nang Mag-isa ang Cookie</a>
				</nav>
			</div>

			<div class="prose-fil !max-w-none">
				<!-- 1. Panimula -->
				<section id="intro" class="scroll-mt-28">
					<h2 class="h2 mb-5 text-pine-950">1. Ano ang Cookie</h2>
					<p>
						Ang Cookie ay maliliit na tekstong file na itinatago ng website sa iyong kagamitan sa pamamagitan ng browser kapag bumibisita ka. Malawak ang paggamit nito upang matiyak na maayos na tumatakbo ang website, mapataas ang kahusayan nito, maalala ang kagustuhan ng user, makilala ang mga bumabalik na bisita - at, kapag may pahintulot, masukat ang daloy ng trapiko sa pagbisita.
					</p>
					<p>
						Kasama rin sa mga katulad na teknolohiya ang: lokal na imbakan (localStorage / sessionStorage), mga pixel tag, at device fingerprint. Ginagamit lamang ng website na ito ang mga teknolohiyang ito sa kinakailangang saklaw. Hindi kami nangongolekta ng impormasyong lampas sa inihayag na layunin sa mga nakatagong paraan.
					</p>
				</section>
			</div>

			<!-- Panel ng Cookie (card na may switch at paliwanag) -->
			<section id="cookie-panel" aria-label="Panel ng pamamahala sa kagustuhan ng Cookie" class="mt-10 sm:mt-14 mb-10 sm:mb-14">
				<div class="grid grid-cols-1 gap-4 sm:gap-5">
					<!-- 2. Kinakailangang Cookie -->
					<article id="necessary" class="card border border-pine-100 shadow-soft p-5 sm:p-6 scroll-mt-28">
						<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
							<div class="flex-1">
								<div class="flex items-center gap-3 mb-3">
									<span class="text-2xl" aria-hidden="true">🛡️</span>
									<h3 class="text-lg sm:text-xl font-bold text-pine-950">2. Kinakailangang Cookie</h3>
								</div>
								<p class="text-sm text-slate-700 leading-relaxed mb-3">
									Ang mga Cookie na ito ay mahalaga sa pangunahing pagpapatakbo ng website. Karaniwan itong itinatakda lamang kapag gumawa ka ng mga gawi na katumbas ng hiling sa serbisyo - halimbawa: papanatili ng katayuan sa pag-sign in, pagtatago ng nilalaman ng shopping cart, pagtiyak sa seguridad ng hiling sa pagitan ng mga pahina, at pagtatago ng iyong katayuan ng pahintulot sa privacy.
								</p>
								<p class="text-sm text-slate-700 leading-relaxed mb-3">
									<strong>Halimbawa ng gamit:</strong>
								</p>
								<ul class="text-sm text-slate-700 space-y-1.5 list-disc list-outside ms-6">
									<li>Tandaan ang iyong katayuan ng pahintulot sa Cookie, upang hindi muling magtanong sa bawat pagbisita;</li>
									<li>Tiyakin ang pagkakapare-pareho at seguridad ng pakikipag-ugnayan sa pahina at pagpasa ng mga aksyon sa loob ng session;</li>
									<li>Sa panahon ng mataas na daloy o pag-atake - pansamantalang kilalanin ang mga hindi normal na hiling kasama ang mekanismo ng pagtatanggol.</li>
								</ul>
								<p class="text-xs font-bold uppercase tracking-[0.15em] text-amber-700 mt-4 inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3 py-1.5">
									🔒 Kinakailangang Cookie · Palaging Aktibo
								</p>
							</div>
							<div class="shrink-0 lg:w-40 flex lg:justify-end">
								<label class="relative inline-flex items-center cursor-not-allowed">
									<input type="checkbox" checked disabled aria-label="Ang kinakailangang Cookie ay laging nakabukas" class="sr-only peer" />
									<div class="w-12 h-6 bg-pine-700 rounded-full peer-disabled:opacity-100 transition-colors"></div>
									<div class="absolute left-0.5 top-0.5 bg-white w-5 h-5 rounded-full shadow-sm border border-slate-200 translate-x-6 transition-transform flex items-center justify-center text-[10px] font-bold text-pine-800" aria-hidden="true">✓</div>
								</label>
							</div>
						</div>
					</article>

					<!-- 3. Cookie para sa Pagsusuri -->
					<article id="analytics" class="card border border-pine-100 shadow-soft p-5 sm:p-6 scroll-mt-28">
						<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
							<div class="flex-1">
								<div class="flex items-center gap-3 mb-3">
									<span class="text-2xl" aria-hidden="true">📊</span>
									<h3 class="text-lg sm:text-xl font-bold text-pine-950">3. Cookie para sa Pagsusuri</h3>
								</div>
								<p class="text-sm text-slate-700 leading-relaxed mb-3">
									Tinutulungan ka nilang maunawaan kung paano nakikipag-ugnayan ang mga bisita sa website na ito sa pamamagitan ng pagkolekta ng hindi nagpapakakilanlang datos ng paggamit. Ang mga datos ay gagana lamang kapag ikaw ay tahasang pumayag - at <strong>hindi para sa layuning kilalanin ang isang tiyak na indibidwal</strong>.
								</p>
								<div class="rounded-2xl border border-slate-100 bg-slate-50/80 p-4 sm:p-5 mb-4">
									<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
										<h4 class="text-sm font-bold text-pine-900">Google Analytics</h4>
										<span class="chip !bg-pine-50 !border-pine-200 !text-pine-800 !text-xs">Kagamitan sa Pagsusuri</span>
									</div>
									<p class="text-sm text-slate-700 leading-relaxed">
										Kinokolekta nito ang hindi nagpapakakilanlang impormasyon kung paano ginagamit ng mga bisita ang aming website: halimbawa, binibisitang pahina, tagal ng pananatili, pinagmulan ng pagtalon, uri ng kagamitan, at iba pa. Ang mga datos na ito ay pinagsasama-sama para maging ulat, upang matulungan kaming i-optimize ang istraktura ng nilalaman, ayusin ang mga link na may mali, at itaas ang pangkalahatang karanasan sa pagbabasa.
									</p>
								</div>
								<p class="text-xs text-slate-500">
									Kung bubuksan mo ito - gagamitin namin nang default ang mode ng <em>"IP anonymization"</em>, at lilikd hangga't maaari ang pagproseso sa mga datos na makakakilala sa indibidwal.
								</p>
							</div>
							<div class="shrink-0 lg:w-40 flex lg:justify-end">
								<label class="relative inline-flex items-center cursor-pointer">
									<input type="checkbox" data-cookie-switch="analytics" checked aria-label="Ang Cookie para sa pagsusuri ay aktibo" class="sr-only peer" />
									<div class="w-12 h-6 bg-slate-200 rounded-full peer-checked:bg-pine-700 transition-colors"></div>
									<div class="absolute left-0.5 top-0.5 bg-white w-5 h-5 rounded-full shadow-sm border border-slate-200 transition-transform flex items-center justify-center text-[10px] font-bold peer-checked:translate-x-6 peer-checked:text-pine-800" aria-hidden="true">
										<span data-cookie-toggle-icon="analytics">✓</span>
									</div>
								</label>
								<p data-cookie-status="analytics" class="ml-3 mt-2 lg:mt-0 text-xs font-bold text-pine-800 lg:hidden">Aktibo</p>
							</div>
						</div>
					</article>

					<!-- 4. Cookie para sa Kagustuhan -->
					<article id="preferences" class="card border border-pine-100 shadow-soft p-5 sm:p-6 scroll-mt-28">
						<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
							<div class="flex-1">
								<div class="flex items-center gap-3 mb-3">
									<span class="text-2xl" aria-hidden="true">⚙️</span>
									<h3 class="text-lg sm:text-xl font-bold text-pine-950">4. Cookie para sa Kagustuhan</h3>
								</div>
								<p class="text-sm text-slate-700 leading-relaxed mb-3">
									Ginagamit ang mga ito upang tandaan ang iyong mga kagustuhan sa mga pagkakataong paulit-ulit kang bibisita - upang magbigay ng karanasang mas angkop sa iyong gawi kapag bumalik ka muli (halimbawa, tema ng interface, densidad ng pagpapakita, kagustuhan sa laki ng font, at iba pa).
								</p>
								<div class="rounded-2xl border border-slate-100 bg-slate-50/80 p-4 sm:p-5">
									<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
										<h4 class="text-sm font-bold text-pine-900">Kagustuhan ng User</h4>
										<span class="chip !bg-pine-50 !border-pine-200 !text-pine-800 !text-xs">Mga Setting ng Karanasan</span>
									</div>
									<p class="text-sm text-slate-700 leading-relaxed">
										Tandaan ang iyong kagustuhan sa wika, tema ng interface at mode ng pagpapakita, antas ng pahintulot sa Cookie, gawi sa pag-filter at pag-aayos ng paghahanap, at iba pang mga setting ng website.
									</p>
								</div>
							</div>
							<div class="shrink-0 lg:w-40 flex lg:justify-end">
								<label class="relative inline-flex items-center cursor-pointer">
									<input type="checkbox" data-cookie-switch="preferences" checked aria-label="Ang Cookie para sa kagustuhan ay aktibo" class="sr-only peer" />
									<div class="w-12 h-6 bg-slate-200 rounded-full peer-checked:bg-pine-700 transition-colors"></div>
									<div class="absolute left-0.5 top-0.5 bg-white w-5 h-5 rounded-full shadow-sm border border-slate-200 transition-transform flex items-center justify-center text-[10px] font-bold peer-checked:translate-x-6 peer-checked:text-pine-800" aria-hidden="true">
										<span data-cookie-toggle-icon="preferences">✓</span>
									</div>
								</label>
								<p data-cookie-status="preferences" class="ml-3 mt-2 lg:mt-0 text-xs font-bold text-pine-800 lg:hidden">Aktibo</p>
							</div>
						</div>
					</article>

					<!-- 5. Cookie para sa Pagmemerkado -->
					<article id="marketing" class="card border border-pine-100 shadow-soft p-5 sm:p-6 scroll-mt-28">
						<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
							<div class="flex-1">
								<div class="flex items-center gap-3 mb-3">
									<span class="text-2xl" aria-hidden="true">📣</span>
									<h3 class="text-lg sm:text-xl font-bold text-pine-950">5. Cookie para sa Pagmemerkado</h3>
								</div>
								<p class="text-sm text-slate-700 leading-relaxed mb-3">
									Karaniwan itong itinatakda ng aming mga kasosyo sa patalastas - upang bumuo ng larawan ng iyong interes sa iba't ibang website, ipakita ang may kaugnay na patalastas sa ibang plataporma, at sukatin ang bisa ng pagpapalabas ng aktibidad sa patalastas.
								</p>
								<div class="rounded-2xl border border-rose-sand-100 bg-rose-sand-50/60 p-4 sm:p-5">
									<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
										<h4 class="text-sm font-bold text-rose-sand-800">Personal na Patalastas</h4>
										<span class="chip !bg-white/70 !border-rose-sand-200 !text-rose-sand-700 !text-xs">Default na Naka-patay</span>
									</div>
									<p class="text-sm text-slate-700 leading-relaxed">
										Batay sa iyong interes sa pagba-browse at larawan - magpapadala ng may kaugnay na nilalaman o patalastas sa website ng ikatlong partido. Ang mga ganitong uri ng Cookie ay hindi gagana maliban kung ikaw ay tahasang pumayag.
									</p>
								</div>
							</div>
							<div class="shrink-0 lg:w-40 flex lg:justify-end">
								<label class="relative inline-flex items-center cursor-pointer">
									<input type="checkbox" data-cookie-switch="marketing" aria-label="Ang Cookie para sa pagmemerkado ay hindi aktibo" class="sr-only peer" />
									<div class="w-12 h-6 bg-slate-200 rounded-full peer-checked:bg-pine-700 transition-colors"></div>
									<div class="absolute left-0.5 top-0.5 bg-white w-5 h-5 rounded-full shadow-sm border border-slate-200 transition-transform flex items-center justify-center text-[10px] font-bold peer-checked:translate-x-6 peer-checked:text-pine-800" aria-hidden="true">
										<span data-cookie-toggle-icon="marketing">—</span>
									</div>
								</label>
								<p data-cookie-status="marketing" class="ml-3 mt-2 lg:mt-0 text-xs font-bold text-slate-500 lg:hidden">Hindi Aktibo</p>
							</div>
						</div>
					</article>
				</div>
			</section>

			<div class="prose-fil !max-w-none">
				<!-- 6. Pamamahala ng pahintulot -->
				<section id="consent" class="scroll-mt-28">
					<h2 class="h2 mb-5 text-pine-950">6. Pamamahala ng Pahintulot</h2>
					<p>
						Sa pamamagitan ng pahinang ito - maaari mong tingnan, ayusin, o bawiin ang iyong mga kagustuhan sa Cookie anumang oras. Lahat ng pagpipilian ay itatago sa browser ng kasalukuyan mong kagamitan - hindi ia-upload sa aming server.
					</p>
					<p>
						Bago mo pindutin ang "I-save ang mga Setting" - ito ang default naming gagawin:
					</p>
					<ul>
						<li>Buksan ang kinakailangang Cookie (hindi maaaring isara);</li>
						<li>Ang Cookie para sa pagsusuri at kagustuhan ay default na iminumungkahing bukas - maaari mo itong isara anumang oras;</li>
						<li>Ang Cookie para sa pagmemerkado ay default na <strong>hindi aktibo</strong> - gagana lamang kapag binuksan mo ito nang kusa.</li>
					</ul>
					<p>
						<strong>Mangyaring tandaan:</strong> ang pagpatay sa ilang Cookie ay maaaring makaapekto sa pagganap ng website (halimbawa, hindi matandaan ang iyong kagustuhan sa tema, hindi makagawa ng anonymous na istatistika sa trapiko, at iba pa) - ngunit hindi makakaapekto sa pangunahing kakayahang magbasa at bumisita.
					</p>
				</section>

				<hr />

				<!-- 7. Pamamahala nang mag-isa -->
				<section id="how-to-manage" class="scroll-mt-28">
					<h2 class="h2 mb-5 text-pine-950">7. Paano Pamahalaan nang Mag-isa ang Cookie</h2>
					<p>
						Bukod sa panel sa pahinang ito - maaari ka ring direktang pamahalaan o burahin ang Cookie gamit ang mga setting na naka-built-in sa browser. Narito ang karaniwang reference ng pasukan para sa mga kilalang browser (ang pangalan o ruta ay maaaring magbago kasunod ng pag-update ng bersyon):
					</p>
					<ul>
						<li><strong>Chrome / Edge / Brave:</strong> Mga Setting → Privacy at Seguridad → Cookie at iba pang datos ng website;</li>
						<li><strong>Firefox:</strong> Mga Setting → Privacy at Seguridad → Cookie at datos ng website;</li>
						<li><strong>Safari (macOS):</strong> Mga Setting → Privacy → Pamahalaan ang datos ng website;</li>
						<li><strong>Safari (iOS):</strong> Mga Setting → Safari → Advanced → Datos ng website;</li>
						<li><strong>Browser sa mobile:</strong> Karaniwan ay matatagpuan ang angkop na opsyon sa Mga Setting → Privacy / Seguridad.</li>
					</ul>
					<p>
						Maaari mo ring buksan ang senyas ng <em>"Huwag subaybayan (Do Not Track)"</em> sa ilang browser. Bago pa man namin itatag ang awtomatikong pagproseso para sa senyas na ito - mananatiling ituturing ang kagustuhan sa Cookie ng pahinang ito bilang batayan.
					</p>
				</section>
			</div>

			<!-- Bar ng pagpapatakbo: I-save / Tanggihan -->
			<section aria-label="Bar ng pagpapatakbo para sa pahintulot sa Cookie" class="mt-12 sm:mt-16">
				<div class="surface-pine rounded-[2rem] border border-pine-100 shadow-card p-6 sm:p-8 md:p-10">
					<h2 class="h2 mb-3 text-pine-950">Kumpirmahin ang Iyong mga Setting</h2>
					<p class="text-slate-700 text-base sm:text-lg leading-relaxed mb-6 sm:mb-8">
						Mangyaring ayusin ang lahat ng switch sa itaas batay sa iyong pangangailangan - pagkatapos ay pindutin ang pindutan sa ibaba upang i-save ang mga setting. Maaari mo ring pindutin nang isang beses upang tanggihan ang lahat ng hindi kinakailangang Cookie.
					</p>

					<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
						<div id="cookie-preference-summary" class="text-xs sm:text-sm text-slate-600">
							Kasalukuyang setting: Kinakailangang Cookie <strong class="text-pine-800">Aktibo</strong>, para sa Pagsusuri
							<span data-cookie-summary="analytics" class="font-semibold text-pine-800">Aktibo</span>, para sa Kagustuhan
							<span data-cookie-summary="preferences" class="font-semibold text-pine-800">Aktibo</span>, para sa Pagmemerkado
							<span data-cookie-summary="marketing" class="font-semibold text-slate-500">Hindi Aktibo</span>.
						</div>
						<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
							<button type="button" data-cookie-action="reject" class="btn-secondary btn-wide">
								Tanggihan ang Lahat
							</button>
							<button type="button" data-cookie-action="accept" class="btn-primary btn-wide">
								I-save ang mga Setting
								<span aria-hidden="true">→</span>
							</button>
						</div>
					</div>

					<p id="cookie-saved-notice" class="hidden mt-5 text-sm font-semibold text-pine-800 inline-flex items-center gap-2 rounded-2xl bg-pine-50 border border-pine-200 px-4 py-2.5">
						✅ Nai-save na ang Iyong mga Kagustuhan sa Cookie. Gagana ito ayon sa mga setting sa itaas matapos i-refresh ang pahina.
					</p>
				</div>
			</section>

			<!-- Bumalik sa ibaba -->
			<div class="mt-12 sm:mt-16 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
				<a href="/" class="btn-primary btn-wide">Bumalik sa Tahanan
					<span aria-hidden="true">→</span>
				</a>
				<div class="flex flex-wrap gap-3">
					<a href="/privacy/" class="btn-secondary btn-wide">Tingnan ang Patakaran sa Privacy</a>
					<a href="/terms/" class="btn-secondary btn-wide">Tingnan ang Mga Tuntunin</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script is:inline>
	(function () {
		'use strict';

		const STORAGE_KEY = 'bp_cookie_preferences_v1';
		const CATEGORIES = ['analytics', 'preferences', 'marketing'];
		const DEFAULTS = { analytics: true, preferences: true, marketing: false };

		function readPreferences() {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return Object.assign({}, DEFAULTS);
				const parsed = JSON.parse(raw);
				const result = {};
				CATEGORIES.forEach(function (cat) {
					result[cat] = typeof parsed[cat] === 'boolean' ? parsed[cat] : !!DEFAULTS[cat];
				});
				return result;
			} catch (e) {
				return Object.assign({}, DEFAULTS);
			}
		}

		function writePreferences(prefs) {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
			} catch (e) {}
		}

		function applyUI(prefs) {
			CATEGORIES.forEach(function (cat) {
				const on = !!prefs[cat];
				const switchEl = document.querySelector('[data-cookie-switch="' + cat + '"]');
				const iconEl = document.querySelector('[data-cookie-toggle-icon="' + cat + '"]');
				const statusEl = document.querySelector('[data-cookie-status="' + cat + '"]');
				const summaryEl = document.querySelector('[data-cookie-summary="' + cat + '"]');

				if (switchEl) switchEl.checked = on;
				if (iconEl) iconEl.textContent = on ? '✓' : '—';
				if (statusEl) {
					statusEl.textContent = on ? 'Aktibo' : 'Hindi Aktibo';
					statusEl.classList.remove('text-pine-800', 'text-slate-500');
					statusEl.classList.add(on ? 'text-pine-800' : 'text-slate-500');
				}
				if (summaryEl) {
					summaryEl.textContent = on ? 'Aktibo' : 'Hindi Aktibo';
					summaryEl.classList.remove('text-pine-800', 'text-slate-500');
					summaryEl.classList.add(on ? 'text-pine-800' : 'text-slate-500');
				}
			});
		}

		function collectFromUI() {
			const prefs = {};
			CATEGORIES.forEach(function (cat) {
				const switchEl = document.querySelector('[data-cookie-switch="' + cat + '"]');
				prefs[cat] = switchEl ? !!switchEl.checked : !!DEFAULTS[cat];
			});
			return prefs;
		}

		function showSavedNotice() {
			const el = document.getElementById('cookie-saved-notice');
			if (!el) return;
			el.classList.remove('hidden');
			el.scrollIntoView({ behavior: 'smooth', block: 'center' });
			window.clearTimeout(showSavedNotice._t);
			showSavedNotice._t = window.setTimeout(function () {
				el.classList.add('hidden');
			}, 6000);
		}

		document.addEventListener('DOMContentLoaded', function () {
			const initial = readPreferences();
			applyUI(initial);

			CATEGORIES.forEach(function (cat) {
				const switchEl = document.querySelector('[data-cookie-switch="' + cat + '"]');
				if (!switchEl) return;
				switchEl.addEventListener('change', function () {
					const next = collectFromUI();
					applyUI(next);
				});
			});

			const acceptBtn = document.querySelector('[data-cookie-action="accept"]');
			const rejectBtn = document.querySelector('[data-cookie-action="reject"]');

			if (acceptBtn) {
				acceptBtn.addEventListener('click', function () {
					const next = collectFromUI();
					writePreferences(next);
					applyUI(next);
					showSavedNotice();
				});
			}

			if (rejectBtn) {
				rejectBtn.addEventListener('click', function () {
					const next = { analytics: false, preferences: false, marketing: false };
					writePreferences(next);
					applyUI(next);
					showSavedNotice();
				});
			}
		});
	})();
</script>
